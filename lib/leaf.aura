; lib/leaf.aura — the ONLY module that names the workspace hot leaves.
;
; Every engine module calls leaf:* instead of rk-* directly. Workaround for
; aura#4547: after mutate:rebind / hot-strategy:heal! of a workspace define,
; a module (loaded after the module that ran set-code + eval-current) whose
; references to workspace defines are not in workspace definition order can
; call a DIFFERENT define. Here they appear exactly in ws/hot.aura order, and
; tests/test_leaf.aura rebinds each leaf and checks every leaf:* follows it.
(export leaf:checksum leaf:hash leaf:bloom-probe leaf:dec leaf:block-seek
        leaf:pad leaf:entry-encode leaf:wal-record leaf:block-build leaf:bloom-build leaf:bloom-may leaf:block-get leaf:cache-sim
        leaf:sst-build leaf:sst-build-k leaf:sst-merge leaf:sst-merge-k
        leaf:memtable-rep leaf:compaction-style leaf:l0-trigger leaf:max-runs leaf:cache-policy leaf:bloom-reads
        leaf:install! leaf:installed leaf:uninstall-all!)
(require "hot" all:)

(define leaf-k-checksum #f)
(define (leaf:checksum s start end)
  (if (and leaf-k-checksum (string? s))
      (let ((r (leaf-k-checksum s (string-length s) start end))) (if (exact? r) r (rk-checksum s start end)))
      (rk-checksum s start end)))
(define leaf-k-hash #f)
(define (leaf:hash s seed)
  (if (and leaf-k-hash (string? s))
      (let ((r (leaf-k-hash s (string-length s) seed))) (if (exact? r) r (rk-hash s seed)))
      (rk-hash s seed)))
(define (leaf:bloom-probe bits nbits h k) (rk-bloom-probe bits nbits h k))
(define leaf-k-dec #f)
(define (leaf:dec s off w)
  (if (and leaf-k-dec (string? s))
      (let ((r (leaf-k-dec s (string-length s) off w))) (if (exact? r) r (rk-dec s off w)))
      (rk-dec s off w)))
(define leaf-k-block-seek #f)
(define (leaf:block-seek blk key n ra)
  (if (and leaf-k-block-seek (string? blk) (string? key))
      (let ((r (leaf-k-block-seek blk (string-length blk) key (string-length key) n ra))) (if (exact? r) r (rk-block-seek blk key n ra)))
      (rk-block-seek blk key n ra)))
(define leaf-k-pad #f)
(define (leaf:pad n w)
  (if (and leaf-k-pad )
      (let ((r (leaf-k-pad n w))) (if (string? r) r (rk-pad n w)))
      (rk-pad n w)))
(define leaf-k-entry-encode #f)
(define (leaf:entry-encode type key val)
  (if (and leaf-k-entry-encode (string? key) (string? val))
      (let ((r (leaf-k-entry-encode type key (string-length key) val (string-length val)))) (if (string? r) r (rk-entry-encode type key val)))
      (rk-entry-encode type key val)))
(define leaf-k-wal-record #f)
(define (leaf:wal-record type key val)
  (if (and leaf-k-wal-record (string? key) (string? val))
      (let ((r (leaf-k-wal-record type key (string-length key) val (string-length val)))) (if (string? r) r (rk-wal-record type key val)))
      (rk-wal-record type key val)))
(define leaf-k-block-build #f)
(define (leaf:block-build blob)
  (if (and leaf-k-block-build (string? blob))
      (let ((r (leaf-k-block-build blob (string-length blob)))) (if (string? r) r (rk-block-build blob)))
      (rk-block-build blob)))
(define leaf-k-bloom-build #f)
(define (leaf:bloom-build blob bpk)
  (if (and leaf-k-bloom-build (string? blob))
      (let ((r (leaf-k-bloom-build blob (string-length blob) bpk))) (if (string? r) r (rk-bloom-build blob bpk)))
      (rk-bloom-build blob bpk)))
(define leaf-k-bloom-may #f)
(define (leaf:bloom-may bits nbits k key)
  (if (and leaf-k-bloom-may (string? bits) (string? key))
      (let ((r (leaf-k-bloom-may bits (string-length bits) nbits k key (string-length key)))) (if (exact? r) r (rk-bloom-may bits nbits k key)))
      (rk-bloom-may bits nbits k key)))
(define leaf-k-block-get #f)
(define (leaf:block-get blk key)
  (if (and leaf-k-block-get (string? blk) (string? key))
      (let ((r (leaf-k-block-get blk (string-length blk) key (string-length key)))) (if (string? r) r (rk-block-get blk key)))
      (rk-block-get blk key)))
(define leaf-k-cache-sim #f)
(define (leaf:cache-sim policy cap trace)
  (if (and leaf-k-cache-sim (string? trace))
      (let ((r (leaf-k-cache-sim policy cap trace (string-length trace)))) (if (exact? r) r (rk-cache-sim policy cap trace)))
      (rk-cache-sim policy cap trace)))

; whole-table kernels: the -k form answers the kernel's String or #f (no slot /
; refused) so the engine keeps its own module path; the plain form falls back
; to the workspace define (the specification).
(define leaf-k-sst-build #f)
(define (leaf:sst-build-k blob bb bpk)
  (if (and leaf-k-sst-build (string? blob))
      (let ((r (leaf-k-sst-build blob (string-length blob) bb bpk))) (if (string? r) r #f))
      #f))
(define (leaf:sst-build blob bb bpk)
  (let ((r (leaf:sst-build-k blob bb bpk))) (if r r (rk-sst-build blob bb bpk))))
(define leaf-k-sst-merge #f)
(define (leaf:sst-merge-k files bottom target bb bpk)
  (if (and leaf-k-sst-merge (string? files))
      (let ((r (leaf-k-sst-merge files (string-length files) bottom target bb bpk))) (if (string? r) r #f))
      #f))
(define (leaf:sst-merge files bottom target bb bpk)
  (let ((r (leaf:sst-merge-k files bottom target bb bpk))) (if r r (rk-sst-merge files bottom target bb bpk))))

(define (leaf:memtable-rep) (rk-memtable-rep))
(define (leaf:compaction-style) (rk-compaction-style))
(define (leaf:l0-trigger) (rk-l0-trigger))
(define (leaf:max-runs) (rk-max-runs))
(define (leaf:cache-policy) (rk-cache-policy))
(define (leaf:bloom-reads) (rk-bloom-reads))

; ---- host slots (aura-kernel-sink policy:sink-host!): a slot holds the raw
; c-func of kernels/rocks_leaves.c or #f. The entry point passes Strings to
; the "S" params only (c-func does not type-check, aura#4551), uses the
; kernel's answer when it has the declared type (a refusal is NULL / a Float
; sentinel) and otherwise runs the Aura define. No workspace mutation.
(define (leaf:install! name k)
  (cond ((equal? name "rk-checksum") (set! leaf-k-checksum k) #t)
        ((equal? name "rk-hash") (set! leaf-k-hash k) #t)
        ((equal? name "rk-dec") (set! leaf-k-dec k) #t)
        ((equal? name "rk-block-seek") (set! leaf-k-block-seek k) #t)
        ((equal? name "rk-pad") (set! leaf-k-pad k) #t)
        ((equal? name "rk-entry-encode") (set! leaf-k-entry-encode k) #t)
        ((equal? name "rk-wal-record") (set! leaf-k-wal-record k) #t)
        ((equal? name "rk-block-build") (set! leaf-k-block-build k) #t)
        ((equal? name "rk-bloom-build") (set! leaf-k-bloom-build k) #t)
        ((equal? name "rk-bloom-may") (set! leaf-k-bloom-may k) #t)
        ((equal? name "rk-block-get") (set! leaf-k-block-get k) #t)
        ((equal? name "rk-cache-sim") (set! leaf-k-cache-sim k) #t)
        ((equal? name "rk-sst-build") (set! leaf-k-sst-build k) #t)
        ((equal? name "rk-sst-merge") (set! leaf-k-sst-merge k) #t)
        (else #f)))
; names whose slot holds a kernel
(define (leaf:installed)
  (let loop ((xs (list (cons "rk-checksum" leaf-k-checksum) (cons "rk-hash" leaf-k-hash) (cons "rk-dec" leaf-k-dec) (cons "rk-block-seek" leaf-k-block-seek) (cons "rk-pad" leaf-k-pad) (cons "rk-entry-encode" leaf-k-entry-encode) (cons "rk-wal-record" leaf-k-wal-record) (cons "rk-block-build" leaf-k-block-build) (cons "rk-bloom-build" leaf-k-bloom-build) (cons "rk-bloom-may" leaf-k-bloom-may) (cons "rk-block-get" leaf-k-block-get) (cons "rk-cache-sim" leaf-k-cache-sim) (cons "rk-sst-build" leaf-k-sst-build) (cons "rk-sst-merge" leaf-k-sst-merge))) (acc (list)))
    (cond ((null? xs) (reverse acc)) ((cdr (car xs)) (loop (cdr xs) (cons (car (car xs)) acc))) (else (loop (cdr xs) acc)))))
(define (leaf:uninstall-all!) (for-each (lambda (n) (leaf:install! n #f)) (leaf:installed)) #t)
