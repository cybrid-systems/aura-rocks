; lib/ru.aura — small helpers shared by the engine (no std list closures).
(export ru:pad ru:concat ru:rev ru:len ru:root ru:path ru:fail ru:max ru:min ru:ascii? ru:sort-idx)

; n as a zero-padded decimal field of width w (n >= 0, fits in w digits).
(define (ru:pad n w)
  (let ((s (number->string n)))
    (if (> (string-length s) w)
        (error (string-append "aura-rocks: field overflow: " s " does not fit " (number->string w) " digits"))
        (let loop ((s s)) (if (< (string-length s) w) (loop (string-append "0" s)) s)))))

; Concatenate a list of strings in one primitive call.
(define (ru:concat parts) (if (null? parts) "" (apply string-append parts)))

(define (ru:rev xs) (let loop ((xs xs) (acc (list))) (if (null? xs) acc (loop (cdr xs) (cons (car xs) acc)))))
(define (ru:len xs) (let loop ((xs xs) (n 0)) (if (null? xs) n (loop (cdr xs) (+ n 1)))))
(define (ru:max a b) (if (> a b) a b))
(define (ru:min a b) (if (< a b) a b))

; Repo root: $ROCKS_ROOT, else ".".
(define (ru:root)
  (let ((r (getenv "ROCKS_ROOT"))) (if (and (string? r) (> (string-length r) 0)) r ".")))
(define (ru:path dir name) (string-append dir "/" name))
(define (ru:fail . parts) (error (ru:concat (cons "aura-rocks: " parts))))

; Keys and values are 7-bit strings: Aura string-ref / string-length count
; code points while files and C kernels see UTF-8 bytes.
(define (ru:ascii? s)
  (let ((n (string-length s)))
    (let loop ((i 0)) (cond ((>= i n) #t) ((> (string-ref s i) 127) #f) (else (loop (+ i 1)))))))

; Indices 0..n-1 of the string vector keys, sorted by key, stable (equal keys
; keep insertion order). Bottom-up merge sort: std/list sort silently returns
; () for a list of strings (aura#4549).
(define (ru-merge! keys src dst lo mid hi)
  (let loop ((i lo) (j mid) (k lo))
    (cond ((>= k hi) #t)
          ((and (< j hi) (or (>= i mid) (string<? (vector-ref keys (vector-ref src j)) (vector-ref keys (vector-ref src i)))))
           (vector-set! dst k (vector-ref src j)) (loop i (+ j 1) (+ k 1)))
          (else (vector-set! dst k (vector-ref src i)) (loop (+ i 1) j (+ k 1))))))
(define (ru:sort-idx keys n)
  (let ((a (make-vector n 0)) (b (make-vector n 0)))
    (let fill ((i 0)) (if (< i n) (begin (vector-set! a i i) (fill (+ i 1))) #t))
    (let pass ((w 1) (src a) (dst b))
      (if (>= w n) src
          (begin
            (let run ((lo 0))
              (if (< lo n)
                  (begin (ru-merge! keys src dst lo (ru:min (+ lo w) n) (ru:min (+ lo (* 2 w)) n)) (run (+ lo (* 2 w))))
                  #t))
            (pass (* 2 w) dst src))))))
