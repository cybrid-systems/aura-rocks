; lib/merge.aura — merging iterator over sorted sources, newest first.
;
; A source is a memtable cursor or an SST iterator:
;   #("mt" mem-cursor)   or   #("sst" sst-iter)   (lib/mem.aura cursor, any rep)
; Sources are given newest first (memtable, L0 newest..oldest, L1...). For a
; key present in several sources the newest wins; the others are skipped.
; Tombstones are returned (type "D"); callers drop them (reads) or keep them
; (compaction into a non-bottom level).
(export merge:new merge:seek! merge:first! merge:next-entry! merge:mem-source merge:sst-source)
(require "ru" all:)
(require "mem" all:)
(require "sst" all:)

(define (merge:mem-source m) (vector "mt" (mem:cursor m)))
(define (merge:sst-source t) (vector "sst" (sst:iter t)))

(define (src-valid? s)
  (if (equal? (vector-ref s 0) "mt") (mem:cur-valid? (vector-ref s 1)) (sst:iter-valid? (vector-ref s 1))))
(define (src-key s)
  (if (equal? (vector-ref s 0) "mt") (mem:cur-key (vector-ref s 1)) (sst:iter-key (vector-ref s 1))))
(define (src-type s)
  (if (equal? (vector-ref s 0) "mt") (mem:cur-type (vector-ref s 1)) (sst:iter-type (vector-ref s 1))))
(define (src-val s)
  (if (equal? (vector-ref s 0) "mt") (mem:cur-val (vector-ref s 1)) (sst:iter-val (vector-ref s 1))))
(define (src-next! s)
  (if (equal? (vector-ref s 0) "mt") (mem:cur-next! (vector-ref s 1)) (sst:iter-next! (vector-ref s 1))))
(define (src-seek! s key)
  (if (equal? (vector-ref s 0) "mt") (mem:cur-seek! (vector-ref s 1) key) (sst:iter-seek! (vector-ref s 1) key)))
(define (src-first! s)
  (if (equal? (vector-ref s 0) "mt") (mem:cur-first! (vector-ref s 1)) (sst:iter-first! (vector-ref s 1))))

; sources: list (newest first) -> merger = vector of sources
(define (merge:new sources) (list->vector sources))
(define (merge:seek! mg key)
  (let loop ((i 0)) (if (< i (vector-length mg)) (begin (src-seek! (vector-ref mg i) key) (loop (+ i 1))) mg)))
(define (merge:first! mg)
  (let loop ((i 0)) (if (< i (vector-length mg)) (begin (src-first! (vector-ref mg i) ) (loop (+ i 1))) mg)))

; Next (type key val) in key order, or #f at the end.
(define (merge:next-entry! mg)
  (let ((n (vector-length mg)))
    ; newest source holding the smallest key
    (let find ((i 0) (best -1) (bkey ""))
      (if (< i n)
          (let ((s (vector-ref mg i)))
            (if (src-valid? s)
                (let ((k (src-key s)))
                  (if (or (< best 0) (string<? k bkey)) (find (+ i 1) i k) (find (+ i 1) best bkey)))
                (find (+ i 1) best bkey)))
          (if (< best 0) #f
              (let* ((b (vector-ref mg best)) (e (list (src-type b) bkey (src-val b))))
                ; advance every source positioned on bkey
                (let adv ((j 0))
                  (if (< j n)
                      (let ((s (vector-ref mg j)))
                        (if (and (src-valid? s) (string=? (src-key s) bkey)) (src-next! s) #f)
                        (adv (+ j 1)))
                      e))))))))
