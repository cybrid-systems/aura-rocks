; lib/db.aura — the LSM engine: open / put / delete / get / scan / flush / compact.
;
; Write path:  WAL append (rio:append!)  ->  memtable (skiplist)
;              memtable >= memtable-bytes  ->  flush to a new L0 SST, new WAL
;              L0 files >= l0-trigger      ->  compaction (style below)
; Read path:   memtable -> L0 newest first -> sorted runs newest first (each
;              run non-overlapping, found by range),
;              each SST: key range, bloom filter, index, verified block, seek.
; Recovery:    MANIFEST (atomic tmp + rename) lists the live SSTs and the WAL;
;              open replays the WAL into a fresh memtable.
; Levels: L0 (overlapping, newest first) and a list of sorted runs below it
; (each run sorted and non-overlapping; "L1" = all runs).
; Compaction style (option, else the workspace define rk-compaction-style):
;   leveled  L0 + every run -> one run (bottommost: tombstones and shadowed
;            versions dropped). One run to read; rewrites everything each time.
;   tiered   L0 -> one new run on top (tombstones kept while older runs exist);
;            when runs > max_runs, all runs -> one run. Low write amp, more
;            runs to read (RocksDB universal compaction, simplified).
; l0_trigger and max_runs: option, else rk-l0-trigger / rk-max-runs.
;
; db = #(dir mem wal-num next-file levels opts stats obs hook)
; hook: #f or (lambda (db event)) called at decision points: "rotate" (before
; the next memtable is created at a flush) and "window" (observer window closed)
; obs: lib/obs.aura workload observer (every put/delete/get/scan is recorded)
(export db:open db:put! db:delete! db:get db:scan db:flush! db:compact! db:close
        db:options db:opt db:set-opt! db:stats db:level-files db:mem db:dir db:destroy! db:wal-path db:obs db:mem-rep db:migrate-mem! db:set-hook! db:runs db:compaction-style db:cache-policy db:bloom-reads? db:cache)
(require "leaf" all:)
(require "ru" all:)
(require "rio" all:)
(require "hot" all:)
(require "entry" all:)
(require "wal" all:)
(require "mem" all:)
(require "sst" all:)
(require "merge" all:)
(require "obs" all:)
(require "cache" all:)

; ---- options: alist ("name" . value)
(define (db:options)
  (list (cons "memtable_bytes" 65536)     ; flush threshold (approx. encoded bytes)
        (cons "l0_trigger" #f)            ; L0 files that trigger a compaction (#f: workspace rk-l0-trigger)
        (cons "compaction_style" #f)      ; "leveled" "tiered" (#f: workspace rk-compaction-style)
        (cons "max_runs" #f)              ; tiered: runs before a full merge (#f: workspace rk-max-runs)
        (cons "target_file_bytes" 262144) ; L1 output file size
        (cons "block_bytes" 4096)
        (cons "bloom_bits" 10)            ; bits per key, 0 = no filter checks
        (cons "sync" #f)                  ; fdatasync every WAL append
        (cons "auto_compact" #t)
        (cons "obs_window" 200)           ; ops per observer window
        (cons "memtable_rep" #f)          ; "skiplist" "vector" "hash", or #f: ask the workspace (rk-memtable-rep)
        (cons "prefix_len" 12)            ; hash rep: bucket key prefix length
        (cons "block_cache_blocks" 0)     ; verified-block cache capacity (blocks), 0 = no cache
        (cons "cache_policy" #f)          ; "lru" "lfu" "clock" (#f: workspace rk-cache-policy)
        (cons "bloom_reads" #f)))         ; 1/0: consult filters on point reads (#f: workspace rk-bloom-reads)
(define (db-opt-in opts key)
  (cond ((null? opts) (ru:fail "unknown option " key)) ((equal? (car (car opts)) key) (cdr (car opts))) (else (db-opt-in (cdr opts) key))))
(define (db-opt-set opts key v)
  (cond ((null? opts) (list (cons key v))) ((equal? (car (car opts)) key) (cons (cons key v) (cdr opts))) (else (cons (car opts) (db-opt-set (cdr opts) key v)))))
(define (db:opt db key) (db-opt-in (vector-ref db 5) key))
(define (db-opt-or db key dflt) (let loop ((o (vector-ref db 5))) (cond ((null? o) dflt) ((equal? (car (car o)) key) (cdr (car o))) (else (loop (cdr o))))))
(define (db:obs db) (vector-ref db 7))
(define (db:set-hook! db f) (vector-set! db 8 f) #t)
(define (db-hook! db event) (if (vector-ref db 8) ((vector-ref db 8) db event) #f))
; after every op: a closed observer window is a decision point
(define (db-after-op! db)
  (let ((o (vector-ref db 7)))
    (if (obs:closed! o) (begin (obs:reset-closed! o) (db-sync-cache-policy! db) (db-hook! db "window")) #f)))
; block cache (process-wide, lib/sst.aura) and its eviction policy
(define (db:cache db) (sst:cache))
(define (db:cache-policy db) (let ((r (db-opt-or db "cache_policy" #f))) (if r r (leaf:cache-policy))))
(define (db-sync-cache-policy! db)
  (let ((c (sst:cache))) (if c (cache:set-policy! c (db:cache-policy db)) #f)))
(define (db:bloom-reads? db)
  (and (> (db:opt db "bloom_bits") 0)
       (let ((r (db-opt-or db "bloom_reads" #f))) (= 1 (if r r (leaf:bloom-reads))))))
; rep for the next memtable: the fixed option, else the workspace define the
; controller hot-swaps (lib/adapt.aura)
(define (db:mem-rep db) (let ((r (db-opt-or db "memtable_rep" #f))) (if r r (leaf:memtable-rep))))
(define (db-new-mem db) (mem:new (db:mem-rep db) (db-opt-or db "prefix_len" 12)))
; switch the live memtable to rep now (copy), instead of at the next rotation
(define (db:migrate-mem! db rep) (vector-set! db 1 (mem:migrate (vector-ref db 1) rep (db-opt-or db "prefix_len" 12))) rep)
(define (db:set-opt! db key v) (vector-set! db 5 (db-opt-set (vector-ref db 5) key v)) v)

; ---- stats
(define db-stat-names (list "puts" "deletes" "gets" "scans" "flushes" "compactions" "wal_bytes" "sst_bytes_written" "compaction_bytes_in" "compaction_bytes_out" "wal_records_replayed" "compaction_ms" "flush_ms"))
(define (db-stat-index name)
  (let loop ((ns db-stat-names) (i 0)) (cond ((null? ns) (ru:fail "unknown stat " name)) ((equal? (car ns) name) i) (else (loop (cdr ns) (+ i 1))))))
(define (db-bump! db name n)
  (let ((v (vector-ref db 6)) (i (db-stat-index name)))
    (vector-set! v i (+ n (vector-ref v i)))
    (if (equal? name "sst_bytes_written") (obs:note-sst-bytes! (vector-ref db 7) n) #f)))
(define (db:stats db)
  (let loop ((ns db-stat-names) (i 0) (acc (list)))
    (if (null? ns) (append (ru:rev acc) (list (cons "l0_files" (ru:len (db:level-files db 0))) (cons "l1_files" (ru:len (db:level-files db 1))) (cons "runs" (ru:len (db:runs db))) (cons "compaction_style" (db:compaction-style db))
                                               (cons "mem_entries" (mem:count (vector-ref db 1))) (cons "mem_rep" (mem:rep (vector-ref db 1))) (cons "io" (rio:mode))
                                               (cons "cache_policy" (if (sst:cache) (cache:policy (sst:cache)) "none"))
                                               (cons "cache_hits" (if (sst:cache) (cache:hits (sst:cache)) 0))
                                               (cons "cache_misses" (if (sst:cache) (cache:misses (sst:cache)) 0))
                                               (cons "bloom_reads" (if (db:bloom-reads? db) 1 0))) (sst:stats))
        (loop (cdr ns) (+ i 1) (cons (cons (car ns) (vector-ref (vector-ref db 6) i)) acc)))))

(define (db:dir db) (vector-ref db 0))
(define (db:mem db) (vector-ref db 1))
; levels = #(l0-tables runs) ; runs = list (newest first) of lists of tables
(define (db:runs db) (vector-ref (vector-ref db 4) 1))
(define (db:level-files db l)
  (if (= l 0) (vector-ref (vector-ref db 4) 0)
      (let loop ((rs (db:runs db)) (acc (list))) (if (null? rs) acc (loop (cdr rs) (append acc (car rs)))))))
(define (db:compaction-style db) (let ((v (db-opt-or db "compaction_style" #f))) (if v v (leaf:compaction-style))))
(define (db-l0-trigger db) (let ((v (db-opt-or db "l0_trigger" #f))) (if v v (leaf:l0-trigger))))
(define (db-max-runs db) (let ((v (db-opt-or db "max_runs" #f))) (if v v (leaf:max-runs))))
(define (db-file db num ext) (ru:path (vector-ref db 0) (string-append (ru:pad num 6) ext)))
(define (db:wal-path db) (db-file db (vector-ref db 2) ".log"))
(define (db-new-file-num! db) (let ((n (vector-ref db 3))) (vector-set! db 3 (+ n 1)) n))

; ---- MANIFEST
(define (db-file-num path)  ; ".../000012.sst" -> 12
  (leaf:dec path (- (string-length path) 10) 6))
(define (db-manifest-text db)
  (let ((names (lambda (ts) (let loop ((ts ts) (acc (list))) (if (null? ts) (ru:rev acc) (loop (cdr ts) (cons (string-append " " (ru:pad (db-file-num (sst:path (car ts))) 6)) acc)))))))
    (ru:concat (append (list "AROCKS-MANIFEST 2\nnext " (number->string (vector-ref db 3)) "\nwal " (number->string (vector-ref db 2)) "\nL0")
                       (names (db:level-files db 0)) (list "\n")
                       (let loop ((rs (db:runs db)) (acc (list))) (if (null? rs) acc (loop (cdr rs) (append acc (list "R") (names (car rs)) (list "\n")))))))))
(define (db-write-manifest! db)
  (let ((tmp (ru:path (vector-ref db 0) "MANIFEST.tmp")))
    (rio:write tmp (db-manifest-text db))
    (rio:rename! tmp (ru:path (vector-ref db 0) "MANIFEST"))))

; manifest text -> (next wal l0-nums runs) ; runs: list of num lists, newest first
; ("L1 ..." from a version 1 manifest is one run)
(define (db-split s ch)  ; split on char code ch, dropping empty pieces
  (let loop ((i 0) (start 0) (acc (list)))
    (cond ((>= i (string-length s)) (ru:rev (if (> i start) (cons (substring s start i) acc) acc)))
          ((= (string-ref s i) ch) (loop (+ i 1) (+ i 1) (if (> i start) (cons (substring s start i) acc) acc)))
          (else (loop (+ i 1) start acc)))))
(define (db-parse-manifest s)
  (let loop ((lines (db-split s 10)) (next 1) (wal 0) (l0 (list)) (l1 (list)))
    (if (null? lines) (list next wal l0 l1)
        (let* ((ws (db-split (car lines) 32)) (tag (car ws)) (nums (let m ((xs (cdr ws)) (acc (list))) (if (null? xs) (ru:rev acc) (m (cdr xs) (cons (string->number (car xs)) acc))))))
          (cond ((equal? tag "next") (loop (cdr lines) (car nums) wal l0 l1))
                ((equal? tag "wal") (loop (cdr lines) next (car nums) l0 l1))
                ((equal? tag "L0") (loop (cdr lines) next wal nums l1))
                ((or (equal? tag "L1") (equal? tag "R")) (loop (cdr lines) next wal l0 (if (null? nums) l1 (append l1 (list nums)))))
                (else (loop (cdr lines) next wal l0 l1)))))))

; ---- open
(define (db:open dir opts)
  (rio:init!)
  (if (hot:loaded?) #f (ru:fail "db:open: call (hot:load!) as a top-level statement first (see lib/hot.aura)"))
  (rio:mkdir! dir)
  (let* ((ms (rio:read (ru:path dir "MANIFEST")))
         (m (if ms (db-parse-manifest ms) (list 1 0 (list) (list))))
         (db (vector dir #f 0 (car m) (vector (list) (list)) (if opts opts (db:options)) (make-vector (ru:len db-stat-names) 0) #f #f))
         (open-all (lambda (nums) (let loop ((ns nums) (acc (list))) (if (null? ns) (ru:rev acc) (loop (cdr ns) (cons (sst:open (db-file db (car ns) ".sst")) acc)))))))
    (vector-set! db 7 (obs:new (db-opt-or db "obs_window" 200)))
    (let ((nb (db-opt-or db "block_cache_blocks" 0)))
      (sst:set-cache! (if (> nb 0) (cache:new (db:cache-policy db) nb 512) #f)))
    (vector-set! db 1 (db-new-mem db))
    (vector-set! (vector-ref db 4) 0 (open-all (car (cdr (cdr m)))))
    (vector-set! (vector-ref db 4) 1 (map open-all (car (cdr (cdr (cdr m))))))
    (if (and ms (> (car (cdr m)) 0))
        (begin
          (vector-set! db 2 (car (cdr m)))
          (let ((r (wal:replay (db:wal-path db) (lambda (type key val) (mem:put! (vector-ref db 1) key type val)))))
            (db-bump! db "wal_records_replayed" (car r))))
        (begin
          (vector-set! db 2 (db-new-file-num! db))
          (db-write-manifest! db)))
    db))

(define (db:close db) #t)
(define (db:destroy! dir) (rio:mkdir! dir) (shell (string-append "rm -rf '" dir "'")) #t)

; ---- writes
(define (db-write! db type key val)
  (if (= (string-length key) 0) (ru:fail "empty key") #f)
  (db-bump! db "wal_bytes" (wal:append! (db:wal-path db) type key val (db:opt db "sync")))
  (mem:put! (vector-ref db 1) key type val)
  (if (>= (mem:bytes (vector-ref db 1)) (db:opt db "memtable_bytes")) (db:flush! db) #f)
  #t)
(define (db:put! db key val)
  (let ((t0 (current-time-ms)))
    (db-bump! db "puts" 1) (db-write! db entry:put key val)
    (obs:put! (vector-ref db 7) key #f (+ (string-length key) (string-length val)) (- (current-time-ms) t0))
    (db-after-op! db)))
(define (db:delete! db key)
  (let ((t0 (current-time-ms)))
    (db-bump! db "deletes" 1) (db-write! db entry:del key "")
    (obs:put! (vector-ref db 7) key #t (string-length key) (- (current-time-ms) t0))
    (db-after-op! db)))

(define (db:flush! db)
  (let ((m (vector-ref db 1)))
    (if (= (mem:count m) 0) #f
        (let* ((num (db-new-file-num! db))
               (meta (sst:write (db-file db num ".sst") (mem:entries m) (db:opt db "block_bytes") (db:opt db "bloom_bits")))
               (old-wal (db:wal-path db)))
          (db-bump! db "flushes" 1)
          (db-bump! db "sst_bytes_written" (car (cdr (cdr meta))))
          (vector-set! (vector-ref db 4) 0 (cons (sst:open (car meta)) (db:level-files db 0)))
          (db-hook! db "rotate")
          (vector-set! db 1 (db-new-mem db))
          (vector-set! db 2 (db-new-file-num! db))
          (db-write-manifest! db)
          (rio:unlink! old-wal)
          (if (and (db:opt db "auto_compact") (>= (ru:len (db:level-files db 0)) (db-l0-trigger db)))
              (db-auto-compact! db) #f)
          #t))))

; ---- compaction
(define (db-sum-sizes ts) (let loop ((ts ts) (n 0)) (if (null? ts) n (loop (cdr ts) (+ n (sst:size (car ts)))))))
(define (db-entry-bytes e) (+ 17 (string-length (car (cdr e))) (string-length (car (cdr (cdr e))))))
; write one output file from cur (reversed entries); returns the opened table
(define (db-write-output! db cur)
  (let* ((num (db-new-file-num! db))
         (meta (sst:write (db-file db num ".sst") (ru:rev cur) (db:opt db "block_bytes") (db:opt db "bloom_bits"))))
    (db-bump! db "compaction_bytes_out" (car (cdr (cdr meta))))
    (db-bump! db "sst_bytes_written" (car (cdr (cdr meta))))
    (sst:open (car meta))))
; merge inputs (newest first) into one sorted run of files; bottommost: drop tombstones
(define (db-merge-run! db inputs bottommost)
  (let ((mg (merge:first! (merge:new (let loop ((ts inputs) (acc (list))) (if (null? ts) (ru:rev acc) (loop (cdr ts) (cons (merge:sst-source (car ts)) acc)))))))
        (target (db:opt db "target_file_bytes")))
    (db-bump! db "compaction_bytes_in" (db-sum-sizes inputs))
    (let loop ((cur (list)) (cur-bytes 0) (outs (list)))
      (let ((e (merge:next-entry! mg)))
        (cond
          ((not e) (ru:rev (if (null? cur) outs (cons (db-write-output! db cur) outs))))
          ((and bottommost (= (car e) entry:del)) (loop cur cur-bytes outs))
          ((>= cur-bytes target) (loop (list e) (db-entry-bytes e) (cons (db-write-output! db cur) outs)))
          (else (loop (cons e cur) (+ cur-bytes (db-entry-bytes e)) outs)))))))
(define (db-install! db l0 runs inputs)
  (vector-set! (vector-ref db 4) 0 l0)
  (vector-set! (vector-ref db 4) 1 (let loop ((rs runs) (acc (list))) (if (null? rs) (ru:rev acc) (loop (cdr rs) (if (null? (car rs)) acc (cons (car rs) acc))))))
  (db-write-manifest! db)
  (let del ((ts inputs)) (if (null? ts) #t (begin (rio:unlink! (sst:path (car ts))) (del (cdr ts)))))
  (db-bump! db "compactions" 1)
  #t)
(define (db-timed! db thunk)
  (let* ((t0 (current-time-ms)) (r (thunk)))
    (db-bump! db "compaction_ms" (- (current-time-ms) t0))
    r))
; full compaction: L0 + every run -> one run (any style; also used when the
; controller leaves tiered)
(define (db:compact! db)
  (db-timed! db (lambda ()
    (let ((inputs (db:level-files db 0)) (all (append (db:level-files db 0) (db:level-files db 1))))
      (if (and (null? inputs) (<= (ru:len (db:runs db)) 1)) #f
          (db-install! db (list) (list (db-merge-run! db all #t)) all))))))
; at a flush, once L0 reached the trigger: by style
(define (db-auto-compact! db)
  (if (equal? (db:compaction-style db) "tiered")
      (db-timed! db (lambda ()
        (let* ((l0 (db:level-files db 0)) (runs (db:runs db))
               (run (db-merge-run! db l0 (null? runs))))
          (db-install! db (list) (cons run runs) l0)
          (if (> (ru:len (db:runs db)) (db-max-runs db))
              (let ((all (db:level-files db 1))) (db-install! db (list) (list (db-merge-run! db all #t)) all))
              #f))))
      (db:compact! db)))

; ---- reads
; -> (hit . probes): hit = #f or (type . val) from the newest run holding key,
; probes = SST files consulted
(define (db-run-get ts key use-bloom)
  (let loop ((ts ts))
    (cond ((null? ts) (cons #f 0))
          ((string<? (sst:largest (car ts)) key) (loop (cdr ts)))
          ((string<? key (sst:smallest (car ts))) (cons #f 0))
          (else (cons (sst:get (car ts) key use-bloom) 1)))))
(define (db-l1-get db key use-bloom)
  (let loop ((rs (db:runs db)) (probes 0))
    (if (null? rs) (cons #f probes)
        (let ((r (db-run-get (car rs) key use-bloom)))
          (if (car r) (cons (car r) (+ probes (cdr r))) (loop (cdr rs) (+ probes (cdr r))))))))
(define (db-resolve hit) (if (and hit (= (car hit) entry:put)) (cdr hit) #f))
; -> #(value level probes): level "mem" "l0" "l1" or #f
(define (db-get-full db key)
  (let* ((x (mem:get (vector-ref db 1) key)) (use-bloom (db:bloom-reads? db)))
    (if x
        (vector (db-resolve x) "mem" 0)
        (let l0 ((ts (db:level-files db 0)) (probes 0))
          (if (null? ts)
              (let ((r (db-l1-get db key use-bloom)))
                (vector (db-resolve (car r)) (if (car r) "l1" #f) (+ probes (cdr r))))
              (let ((hit (sst:get (car ts) key use-bloom)))
                (if hit (vector (db-resolve hit) "l0" (+ probes 1)) (l0 (cdr ts) (+ probes 1)))))))))
(define (db:get db key)
  (db-bump! db "gets" 1)
  (let* ((t0 (current-time-ms)) (r (db-get-full db key)))
    (obs:get! (vector-ref db 7) key (vector-ref r 1) (if (vector-ref r 0) #t #f) (vector-ref r 2) (- (current-time-ms) t0))
    (db-after-op! db)
    (vector-ref r 0)))

; Live (key . val) pairs with start <= key < end (end #f: unbounded), at most limit.
(define (db:scan db start end limit)
  (db-bump! db "scans" 1)
  (let* ((t0 (current-time-ms)) (r (db-scan db start end limit)))
    (obs:scan! (vector-ref db 7) start (ru:len r) (- (current-time-ms) t0))
    (db-after-op! db)
    r))
(define (db-scan db start end limit)
  (let ((mg (merge:seek! (merge:new (cons (merge:mem-source (vector-ref db 1))
                                          (let loop ((ts (append (db:level-files db 0) (db:level-files db 1))) (acc (list)))
                                            (if (null? ts) (ru:rev acc) (loop (cdr ts) (cons (merge:sst-source (car ts)) acc))))))
                         start)))
    (let loop ((n 0) (acc (list)))
      (if (and limit (>= n limit)) (ru:rev acc)
          (let ((e (merge:next-entry! mg)))
            (cond ((not e) (ru:rev acc))
                  ((and end (not (string<? (car (cdr e)) end))) (ru:rev acc))
                  ((= (car e) entry:del) (loop n acc))
                  (else (loop (+ n 1) (cons (cons (car (cdr e)) (car (cdr (cdr e)))) acc)))))))))
