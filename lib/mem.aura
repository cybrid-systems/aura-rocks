; lib/mem.aura — memtable with switchable representations (one interface).
;
;   "skiplist"  lib/memtable.aura: O(log n) put/get, ordered (RocksDB SkipListRep)
;   "vector"    append-only (key type val) vectors: O(1) put, a get scans back
;               from the newest entry, scans/flush sort once (stable merge sort,
;               newest version of a key wins) and reuse the sorted view until
;               the next write (RocksDB VectorRep: bulk loads)
;   "hash"      buckets by fixed-length key prefix (native hash table), one
;               small skiplist per bucket: get/put touch one bucket; ordered
;               iteration walks the buckets in sorted prefix order, which is a
;               total order because the prefix length is fixed (RocksDB
;               HashSkipListRep with a fixed prefix extractor)
;
; The engine picks the rep when it creates a memtable (db open, every flush:
; the memtable rotation boundary); lib/adapt.aura decides which. mem:migrate
; copies a live memtable into another rep (newest versions, tombstones kept).
;
; m = #(rep impl)
(export mem:new mem:rep mem:reps mem:put! mem:get mem:count mem:bytes mem:entries mem:migrate
        mem:cursor mem:cur-seek! mem:cur-first! mem:cur-valid? mem:cur-key mem:cur-type mem:cur-val mem:cur-next!)
(require "ru" all:)
(require "memtable" all:)

(define (mem:reps) (list "skiplist" "vector" "hash"))
(define (mem:rep m) (vector-ref m 0))
(define (mem-impl m) (vector-ref m 1))
(define (mem-is? m r) (equal? (vector-ref m 0) r))

; ---- vector rep: #(keys types vals n bytes view) ; view = #f or #(keys types vals n)
(define (vec-new) (vector (make-vector 64 "") (make-vector 64 0) (make-vector 64 "") 0 0 #f))
(define (vec-grow v)
  (let* ((n (vector-ref v 3)) (cap (vector-length (vector-ref v 0))))
    (if (< n cap) #t
        (let ((ks (make-vector (* 2 cap) "")) (ts (make-vector (* 2 cap) 0)) (vs (make-vector (* 2 cap) "")))
          (let cp ((i 0)) (if (< i n) (begin (vector-set! ks i (vector-ref (vector-ref v 0) i)) (vector-set! ts i (vector-ref (vector-ref v 1) i))
                                             (vector-set! vs i (vector-ref (vector-ref v 2) i)) (cp (+ i 1))) #t))
          (vector-set! v 0 ks) (vector-set! v 1 ts) (vector-set! v 2 vs)))))
(define (vec-put! v k type val)
  (vec-grow v)
  (let ((n (vector-ref v 3)))
    (vector-set! (vector-ref v 0) n k) (vector-set! (vector-ref v 1) n type) (vector-set! (vector-ref v 2) n val)
    (vector-set! v 3 (+ n 1))
    (vector-set! v 4 (+ (vector-ref v 4) (string-length k) (string-length val) 11))
    (vector-set! v 5 #f)))
(define (vec-view v)
  (if (vector-ref v 5) (vector-ref v 5)
      (let* ((n (vector-ref v 3)) (idx (ru:sort-idx (vector-ref v 0) n))
             (ks (make-vector n "")) (ts (make-vector n 0)) (vs (make-vector n "")))
        ; stable sort: the last index of each run of equal keys is the newest
        (let loop ((i 0) (m 0))
          (if (< i n)
              (let ((x (vector-ref idx i)))
                (if (and (< (+ i 1) n) (string=? (vector-ref (vector-ref v 0) x) (vector-ref (vector-ref v 0) (vector-ref idx (+ i 1)))))
                    (loop (+ i 1) m)
                    (begin (vector-set! ks m (vector-ref (vector-ref v 0) x)) (vector-set! ts m (vector-ref (vector-ref v 1) x))
                           (vector-set! vs m (vector-ref (vector-ref v 2) x)) (loop (+ i 1) (+ m 1)))))
              (let ((view (vector ks ts vs m))) (vector-set! v 5 view) view))))))
(define (view-lb view k)  ; first index with key >= k
  (let loop ((lo 0) (hi (vector-ref view 3)))
    (if (>= lo hi) lo
        (let ((mid (quotient (+ lo hi) 2)))
          (if (string<? (vector-ref (vector-ref view 0) mid) k) (loop (+ mid 1) hi) (loop lo mid))))))
(define (vec-get v k)
  (let ((view (vector-ref v 5)))
    (if view
        (let ((i (view-lb view k)))
          (if (and (< i (vector-ref view 3)) (string=? (vector-ref (vector-ref view 0) i) k))
              (cons (vector-ref (vector-ref view 1) i) (vector-ref (vector-ref view 2) i)) #f))
        (let loop ((i (- (vector-ref v 3) 1)))
          (cond ((< i 0) #f)
                ((string=? (vector-ref (vector-ref v 0) i) k) (cons (vector-ref (vector-ref v 1) i) (vector-ref (vector-ref v 2) i)))
                (else (loop (- i 1))))))))

; ---- hash rep: #(table plen prefixes count bytes) ; prefixes = #f or sorted vector of bucket prefixes
(define (hash-new plen) (vector (make-hash) plen #f 0 0))
(define (hash-prefix h k) (let ((p (vector-ref h 1))) (if (> (string-length k) p) (substring k 0 p) k)))
(define (hash-put! h k type val)
  (let* ((p (hash-prefix h k)) (b (hash-ref (vector-ref h 0) p #f)) (b (if b b (let ((nb (mt:new))) (hash-set! (vector-ref h 0) p nb) (vector-set! h 2 #f) nb)))
         (c0 (mt:count b)) (b0 (mt:bytes b)))
    (mt:put! b k type val)
    (vector-set! h 3 (+ (vector-ref h 3) (- (mt:count b) c0)))
    (vector-set! h 4 (+ (vector-ref h 4) (- (mt:bytes b) b0)))))
(define (hash-get h k)
  (let ((b (hash-ref (vector-ref h 0) (hash-prefix h k) #f)))
    (if b (let ((x (mt:get b k))) (if x (cons (mt:type b x) (mt:val b x)) #f)) #f)))
(define (hash-prefixes h)
  (if (vector-ref h 2) (vector-ref h 2)
      (let* ((ps (list->vector (hash-keys (vector-ref h 0)))) (n (vector-length ps)) (idx (ru:sort-idx ps n)) (out (make-vector n "")))
        (let loop ((i 0)) (if (< i n) (begin (vector-set! out i (vector-ref ps (vector-ref idx i))) (loop (+ i 1))) #t))
        (vector-set! h 2 out) out)))

; ---- interface
(define (mem:new rep opts-plen)
  (cond ((equal? rep "skiplist") (vector rep (mt:new)))
        ((equal? rep "vector") (vector rep (vec-new)))
        ((equal? rep "hash") (vector rep (hash-new (if opts-plen opts-plen 12))))
        (else (ru:fail "unknown memtable rep " rep))))
(define (mem:put! m k type val)
  (cond ((mem-is? m "skiplist") (mt:put! (mem-impl m) k type val))
        ((mem-is? m "vector") (vec-put! (mem-impl m) k type val))
        (else (hash-put! (mem-impl m) k type val))))
; #f or (type . val)
(define (mem:get m k)
  (cond ((mem-is? m "skiplist") (let* ((t (mem-impl m)) (x (mt:get t k))) (if x (cons (mt:type t x) (mt:val t x)) #f)))
        ((mem-is? m "vector") (vec-get (mem-impl m) k))
        (else (hash-get (mem-impl m) k))))
; entries held (vector: appended records, including overwritten ones)
(define (mem:count m)
  (cond ((mem-is? m "skiplist") (mt:count (mem-impl m)))
        ((mem-is? m "vector") (vector-ref (mem-impl m) 3))
        (else (vector-ref (mem-impl m) 3))))
(define (mem:bytes m)
  (cond ((mem-is? m "skiplist") (mt:bytes (mem-impl m)))
        (else (vector-ref (mem-impl m) 4))))

; ---- cursors: #(kind ...) ; skiplist #("s" mt node), vector #("v" view i), hash #("h" h prefixes bi mt node)
(define (mem:cursor m)
  (cond ((mem-is? m "skiplist") (vector "s" (mem-impl m) -1))
        ((mem-is? m "vector") (vector "v" (vec-view (mem-impl m)) 0))
        (else (let ((h (mem-impl m))) (vector "h" h (hash-prefixes h) 0 #f -1)))))
(define (cur-is? c k) (equal? (vector-ref c 0) k))
; hash cursor: settle on the first live node at or after (bi, node)
(define (hcur-settle! c)
  (let loop ()
    (if (and (< (vector-ref c 5) 0) (< (vector-ref c 3) (vector-length (vector-ref c 2))))
        (let ((b (hash-ref (vector-ref (vector-ref c 1) 0) (vector-ref (vector-ref c 2) (vector-ref c 3)) #f)))
          (if (vector-ref c 4)  ; current bucket exhausted -> next bucket
              (begin (vector-set! c 3 (+ (vector-ref c 3) 1)) (vector-set! c 4 #f) (loop))
              (begin (vector-set! c 4 b) (vector-set! c 5 (mt:first b))
                     (if (< (vector-ref c 5) 0) (loop) #t))))
        #t)))
(define (mem:cur-first! c)
  (cond ((cur-is? c "s") (vector-set! c 2 (mt:first (vector-ref c 1))))
        ((cur-is? c "v") (vector-set! c 2 0))
        (else (vector-set! c 3 0) (vector-set! c 4 #f) (vector-set! c 5 -1) (hcur-settle! c)))
  c)
(define (mem:cur-seek! c k)
  (cond ((cur-is? c "s") (vector-set! c 2 (mt:seek (vector-ref c 1) k)))
        ((cur-is? c "v") (vector-set! c 2 (view-lb (vector-ref c 1) k)))
        (else
         (let* ((h (vector-ref c 1)) (pk (hash-prefix h k)) (ps (vector-ref c 2)) (n (vector-length ps)))
           (let ((bi (let loop ((lo 0) (hi n)) (if (>= lo hi) lo (let ((mid (quotient (+ lo hi) 2))) (if (string<? (vector-ref ps mid) pk) (loop (+ mid 1) hi) (loop lo mid)))))))
             (vector-set! c 3 bi) (vector-set! c 4 #f) (vector-set! c 5 -1)
             (if (and (< bi n) (string=? (vector-ref ps bi) pk))
                 (let ((b (hash-ref (vector-ref h 0) pk #f)))
                   (vector-set! c 4 b) (vector-set! c 5 (mt:seek b k)))
                 #f)
             (hcur-settle! c)))))
  c)
(define (mem:cur-valid? c)
  (cond ((cur-is? c "s") (>= (vector-ref c 2) 0))
        ((cur-is? c "v") (< (vector-ref c 2) (vector-ref (vector-ref c 1) 3)))
        (else (>= (vector-ref c 5) 0))))
(define (mem:cur-key c)
  (cond ((cur-is? c "s") (mt:key (vector-ref c 1) (vector-ref c 2)))
        ((cur-is? c "v") (vector-ref (vector-ref (vector-ref c 1) 0) (vector-ref c 2)))
        (else (mt:key (vector-ref c 4) (vector-ref c 5)))))
(define (mem:cur-type c)
  (cond ((cur-is? c "s") (mt:type (vector-ref c 1) (vector-ref c 2)))
        ((cur-is? c "v") (vector-ref (vector-ref (vector-ref c 1) 1) (vector-ref c 2)))
        (else (mt:type (vector-ref c 4) (vector-ref c 5)))))
(define (mem:cur-val c)
  (cond ((cur-is? c "s") (mt:val (vector-ref c 1) (vector-ref c 2)))
        ((cur-is? c "v") (vector-ref (vector-ref (vector-ref c 1) 2) (vector-ref c 2)))
        (else (mt:val (vector-ref c 4) (vector-ref c 5)))))
(define (mem:cur-next! c)
  (cond ((cur-is? c "s") (vector-set! c 2 (mt:next (vector-ref c 1) (vector-ref c 2))))
        ((cur-is? c "v") (vector-set! c 2 (+ (vector-ref c 2) 1)))
        (else (vector-set! c 5 (mt:next (vector-ref c 4) (vector-ref c 5)))
              (if (< (vector-ref c 5) 0) (hcur-settle! c) #f)))
  c)

; All live records in key order: list of (type key val)
(define (mem:entries m)
  (let ((c (mem:cur-first! (mem:cursor m))))
    (let loop ((acc (list)))
      (if (mem:cur-valid? c)
          (let ((e (list (mem:cur-type c) (mem:cur-key c) (mem:cur-val c)))) (mem:cur-next! c) (loop (cons e acc)))
          (ru:rev acc)))))
; a new memtable of rep holding m's records (newest version per key)
(define (mem:migrate m rep plen)
  (let ((n (mem:new rep plen)))
    (let loop ((es (mem:entries m)))
      (if (null? es) n (begin (mem:put! n (car (cdr (car es))) (car (car es)) (car (cdr (cdr (car es))))) (loop (cdr es)))))))
