; scripts/bench_adapt_native.aura — the phase bench of scripts/bench_adapt.aura
; on the native data plane (lib/ndb.aura): static configs vs the native control
; plane (lib/nctl.aura). One config per process.
;
;   A  write-heavy, sequential   A_N puts of new keys in key order
;   B  read-heavy, random        B_N ops: 90% get of an existing key, 10% put
;   C  scan-heavy                C_N ops: 70% scan (10 entries), 30% put
;   D  write-heavy, random       D_N puts of random keys (overwrites)
;
; Env: BENCH_CFG  "skiplist:leveled", ... (static), "adaptive" (nctl, native
;                 kernels: EWMA + change detector + background sims) or
;                 "adaptive-v0" (nctl first version: stats parsed in Aura, rules
;                 every window, no sims)
;      BENCH_SCALE (default 10) x (A 1200, B 500, C 150, D 600); NCTL_WINDOW (500)
;      BENCH_OUT (build/bench_adapt_native.jsonl), NCTL_TRAJ (build/nctl-traj.jsonl)
; Each phase row: wall us/op (Aura harness included), native us/op (the data
; plane's own time: write_ns + read_ns + scan_ns deltas), controller ms, and
; the reaction lag: ops from the phase start to the first controller switch.
(require "ru" all:)
(require "rio" all:)
(require "ndb" all:)
(require "nctl" all:)
(require "adapt" all:)

(define (env-or k d) (let ((v (getenv k))) (if (and (string? v) (> (string-length v) 0)) v d)))
(define CFG (env-or "BENCH_CFG" "adaptive"))
(define SCALE (string->number (env-or "BENCH_SCALE" "10")))
(define (sz n) (exact (round (* n SCALE))))
(define A-N (sz 1200)) (define B-N (sz 500)) (define C-N (sz 150)) (define D-N (sz 600))
(define OUT (env-or "BENCH_OUT" (string-append (ru:root) "/build/bench_adapt_native.jsonl")))
(define TRAJ (env-or "NCTL_TRAJ" (string-append (ru:root) "/build/nctl-traj.jsonl")))
(define DIR (string-append (ru:root) "/build/bench-nadapt-" (number->string (current-time-ms))))
(define (cfg-split s) (let loop ((i 0)) (cond ((>= i (string-length s)) (cons s "")) ((= (string-ref s i) 58) (cons (substring s 0 i) (substring s (+ i 1) (string-length s)))) (else (loop (+ i 1))))))
(define ADAPTIVE (or (equal? CFG "adaptive") (equal? CFG "adaptive-v0")))
(define REP (if ADAPTIVE "skiplist" (car (cfg-split CFG))))
(define STYLE (if ADAPTIVE "leveled" (cdr (cfg-split CFG))))
(define opts (list (cons "memtable_bytes" 16384) (cons "target_file_bytes" 65536) (cons "block_bytes" 4096) (cons "bloom_bits" 10)
                   (cons "sync" #f) (cons "auto_compact" #t) (cons "prefix_len" 14) (cons "time_ops" 1) (cons "sample_pct" 5)
                   (cons "memtable_rep" REP) (cons "compaction_style" STYLE)
                   (cons "l0_trigger" (if (equal? STYLE "tiered") 8 4)) (cons "max_runs" 4)))
(ndb:destroy! DIR)
(define db (ndb:open DIR opts))
(define ctl (nctl:new db (if ADAPTIVE TRAJ #f) CFG (list "memtable_rep" "compaction_style")))
(nctl:set-param! ctl "window" (string->number (env-or "NCTL_WINDOW" "500")))
(if (equal? CFG "adaptive-v0") (nctl:set-param! ctl "native" 0) #f)
; the controller is ticked once per TICK ops (BENCH_TICK, default 50; 1 = per op)
(define TICK (string->number (env-or "BENCH_TICK" "50")))

(define (key i) (string-append "user" (substring (number->string (+ 1000000000000 i)) 1 13)))
(define value (list->string (let l ((k 0) (acc (list))) (if (< k 100) (l (+ k 1) (cons (integer->char (+ 97 (modulo (* k 7) 26))) acc)) acc))))
(define seed 77)
(define (rnd! m) (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648)) (modulo (quotient seed 16) m))
(define (stat st name) (let ((p (assoc name st))) (if p (cdr p) 0)))
(define (native-ns st) (+ (stat st "write_ns") (stat st "read_ns") (stat st "scan_ns")))
(define found 0)
(define ops-total 0)
(define (first-switch-after op0)
  (let loop ((rs (nctl:rows ctl)))
    (cond ((null? rs) -1)
          ((and (>= (cdr (assoc "op" (car rs))) op0) (equal? (cdr (assoc "decision" (car rs))) "SWAP")) (- (cdr (assoc "op" (car rs))) op0))
          (else (loop (cdr rs))))))
(define (report! phase ops ms st0 op0 ctl0)
  (let* ((st (ndb:stats db))
         (nus (/ (- (native-ns st) (native-ns st0)) (* 1000.0 ops)))
         (row (list (cons "cfg" CFG) (cons "engine" "native") (cons "phase" phase) (cons "ops" ops) (cons "ms" ms)
                    (cons "us_per_op" (/ (* 1000.0 ms) ops)) (cons "native_us_per_op" nus)
                    (cons "mem_rep" (stat st "mem_rep")) (cons "compaction_style" (stat st "compaction_style")) (cons "runs" (stat st "runs"))
                    (cons "l0_files" (stat st "l0_files")) (cons "flushes" (stat st "flushes")) (cons "compactions" (stat st "compactions"))
                    (cons "compaction_ms" (quotient (stat st "compaction_ns") 1000000)) (cons "sst_bytes_written" (stat st "sst_bytes_written"))
                    (cons "ctl_ms" (- (nctl:overhead-ms ctl) ctl0)) (cons "ctl_ms_total" (nctl:overhead-ms ctl))
                    (cons "windows" (nctl:windows ctl)) (cons "skipped" (nctl:skipped ctl))
                    (cons "switches" (length (nctl:rows ctl))) (cons "lag_ops" (if ADAPTIVE (first-switch-after op0) -1))
                    (cons "tick" TICK) (cons "found" found))))
    (rio:append! OUT (string-append (adapt:json row) "\n") #f)
    (display (string-append "  " phase " ")) (display ops) (display " ops ") (display ms) (display " ms ")
    (display (/ (* 1000.0 ms) ops)) (display " us/op native ") (display nus) (display " us/op ctl ") (display (- (nctl:overhead-ms ctl) ctl0))
    (display " ms mem=") (display (stat st "mem_rep")) (display " cmp=") (display (stat st "compaction_style"))
    (display " lag=") (display (if ADAPTIVE (first-switch-after op0) -1)) (newline)))
(define (now) (current-time-ms))
(define (phase! name n body)
  (let ((st0 (ndb:stats db)) (op0 ops-total) (c0 (nctl:overhead-ms ctl)) (t0 (now)))
    (let chunk ((i 0))
      (if (< i n)
          (let ((e (if (< (+ i TICK) n) (+ i TICK) n)))
            (let loop ((j i)) (if (< j e) (begin (body j) (loop (+ j 1))) #t))
            (if ADAPTIVE (nctl:tick-n! ctl (- e i)) #f)
            (chunk e))
          #t))
    (set! ops-total (+ ops-total n))
    (report! name n (- (now) t0) st0 op0 c0)))
(display (string-append "bench_adapt_native cfg=" CFG " scale=" (number->string SCALE))) (newline)
(define T0 (now)) (define ST0 (ndb:stats db))
(phase! "A_write_seq" A-N (lambda (i) (ndb:put! db (key i) value)))
(phase! "B_read_random" B-N (lambda (i) (if (< (rnd! 10) 9) (if (ndb:get db (key (rnd! A-N))) (set! found (+ found 1)) #f) (ndb:put! db (key (rnd! A-N)) value))))
(phase! "C_scan" C-N (lambda (i) (if (< (rnd! 10) 7) (ndb:scan db (key (rnd! A-N)) #f 10) (ndb:put! db (key (rnd! A-N)) value))))
(phase! "D_write_random" D-N (lambda (i) (ndb:put! db (key (rnd! A-N)) value)))
(report! "total" (+ A-N B-N C-N D-N) (- (now) T0) ST0 0 0)
(if ADAPTIVE (begin (display "  switches: ") (display (nctl:summary ctl)) (newline)) #f)
(define bad 0)
(let loop ((i 0)) (if (< i A-N) (begin (if (equal? (ndb:get db (key i)) value) #f (set! bad (+ bad 1))) (loop (+ i 1))) #t))
(display (list "final check: keys with a wrong value" bad)) (newline)
(ndb:close db)
(ndb:destroy! DIR)
