; scripts/bench_adapt.aura — phase-shifting workload: static configs vs the
; adaptive controller (lib/adapt.aura). One config per process.
;
;   A  write-heavy, sequential   A_N puts of new keys in key order
;   B  read-heavy, random        B_N ops: 90% get of an existing key, 10% put
;   C  scan-heavy                C_N ops: 70% scan (10 entries), 30% put
;   D  write-heavy, random       D_N puts of random keys (overwrites)
;
; Env: BENCH_CFG  "skiplist:leveled", "vector:tiered", "hash:leveled", ... (static)
;                 or "adaptive" (controller on memtable rep + compaction, live)
;      BENCH_SCALE (default 1.0) multiplies the phase sizes (A 1200, B 500, C 150, D 600)
;      BENCH_OUT (build/bench_adapt.jsonl), ADAPT_TRAJ (build/adapt-traj.jsonl), ADAPT_PROPOSAL
(require "ru" all:)
(require "rio" all:)
(require "hot" all:)
(require "db" all:)
(require "obs" all:)
(require "adapt" all:)
(require "rsink" all:)
(hot:load!)   ; top-level statement: see lib/hot.aura
; BENCH_SINK=1: every leaf runs its C kernel (lib/rsink.aura install-all,
; kernels/rocks_leaves.c; setup, not timed); rows carry "sink": 1
(define SINKN (if (equal? (getenv "BENCH_SINK") "1") (length (rsink:install-all!)) 0))

(define (env-or k d) (let ((v (getenv k))) (if (and (string? v) (> (string-length v) 0)) v d)))
(define CFG (env-or "BENCH_CFG" "adaptive"))
(define SCALE (string->number (env-or "BENCH_SCALE" "1.0")))
(define (sz n) (exact (round (* n SCALE))))
(define A-N (sz 1200)) (define B-N (sz 500)) (define C-N (sz 150)) (define D-N (sz 600))
(define OUT (env-or "BENCH_OUT" (string-append (ru:root) "/build/bench_adapt.jsonl")))
(define TRAJ (env-or "ADAPT_TRAJ" (string-append (ru:root) "/build/adapt-traj.jsonl")))
(define DIR (string-append (ru:root) "/build/bench-adapt-" (number->string (current-time-ms))))
(define (cfg-split s) (let loop ((i 0)) (cond ((>= i (string-length s)) (cons s "")) ((= (string-ref s i) 58) (cons (substring s 0 i) (substring s (+ i 1) (string-length s)))) (else (loop (+ i 1))))))
(define ADAPTIVE (equal? CFG "adaptive"))
(define REP (if ADAPTIVE #f (car (cfg-split CFG))))
(define STYLE (if ADAPTIVE #f (cdr (cfg-split CFG))))
(define opts (list (cons "memtable_bytes" 16384) (cons "target_file_bytes" 65536) (cons "block_bytes" 4096) (cons "bloom_bits" 10)
                   (cons "sync" #f) (cons "auto_compact" #t) (cons "obs_window" 100) (cons "prefix_len" 14)
                   (cons "memtable_rep" REP) (cons "compaction_style" STYLE)
                   (cons "l0_trigger" (if ADAPTIVE #f (if (equal? STYLE "tiered") 8 4))) (cons "max_runs" (if ADAPTIVE #f 4))))
(db:destroy! DIR)
(define db (db:open DIR opts))
(define ctl (adapt:new TRAJ (list "memtable_rep" "compaction") #t))
(if ADAPTIVE (adapt:attach! ctl db "bench") #f)

(define (key i) (string-append "user" (ru:pad i 12)))
(define value (list->string (let l ((k 0) (acc (list))) (if (< k 100) (l (+ k 1) (cons (integer->char (+ 97 (modulo (* k 7) 26))) acc)) acc))))
(define seed 77)
(define (rnd! m) (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648)) (modulo (quotient seed 16) m))
(define (stat name) (let loop ((s (db:stats db))) (cond ((null? s) #f) ((equal? (car (car s)) name) (cdr (car s))) (else (loop (cdr s))))))
(define found 0)
(define (report! phase ops ms)
  (let* ((row (list (cons "cfg" CFG) (cons "sink" (if (> SINKN 0) 1 0)) (cons "phase" phase) (cons "ops" ops) (cons "ms" ms) (cons "us_per_op" (/ (* 1000.0 ms) ops))
                    (cons "mem_rep" (stat "mem_rep")) (cons "compaction_style" (stat "compaction_style")) (cons "runs" (stat "runs"))
                    (cons "l0_files" (stat "l0_files")) (cons "flushes" (stat "flushes")) (cons "compactions" (stat "compactions"))
                    (cons "compaction_ms" (stat "compaction_ms")) (cons "sst_bytes_written" (stat "sst_bytes_written"))
                    (cons "adapt_overhead_ms" (adapt:overhead-ms ctl)) (cons "switches" (ru:len (adapt:rows ctl)))
                    (cons "found" found))))
    (rio:append! OUT (string-append (adapt:json row) "\n") #f)
    (display (string-append "  " phase " ")) (display ops) (display " ops ") (display ms) (display " ms ")
    (display (/ (* 1000.0 ms) ops)) (display " us/op  mem=") (display (stat "mem_rep")) (display " cmp=") (display (stat "compaction_style"))
    (display " runs=") (display (stat "runs")) (display " l0=") (display (stat "l0_files")) (newline)))
(define (now) (current-time-ms))
(display (string-append "bench_adapt cfg=" CFG " scale=" (number->string SCALE))) (newline)
(define T0 (now))
; A
(define t0 (now))
(let loop ((i 0)) (if (< i A-N) (begin (db:put! db (key i) value) (loop (+ i 1))) #t))
(report! "A_write_seq" A-N (- (now) t0))
; B
(set! t0 (now))
(let loop ((n 0)) (if (< n B-N) (begin (if (< (rnd! 10) 9) (if (db:get db (key (rnd! A-N))) (set! found (+ found 1)) #f) (db:put! db (key (rnd! A-N)) value)) (loop (+ n 1))) #t))
(report! "B_read_random" B-N (- (now) t0))
; C
(set! t0 (now))
(let loop ((n 0)) (if (< n C-N) (begin (if (< (rnd! 10) 7) (db:scan db (key (rnd! A-N)) #f 10) (db:put! db (key (rnd! A-N)) value)) (loop (+ n 1))) #t))
(report! "C_scan" C-N (- (now) t0))
; D
(set! t0 (now))
(let loop ((n 0)) (if (< n D-N) (begin (db:put! db (key (rnd! A-N)) value) (loop (+ n 1))) #t))
(report! "D_write_random" D-N (- (now) t0))
(report! "total" (+ A-N B-N C-N D-N) (- (now) T0))
(if ADAPTIVE (begin (display "  switches: ") (display (adapt:summary ctl)) (newline)) #f)
; correctness: every key readable with the last value
(define bad 0)
(let loop ((i 0)) (if (< i A-N) (begin (if (equal? (db:get db (key i)) value) #f (set! bad (+ bad 1))) (loop (+ i 1))) #t))
(display (list "final check: keys with a wrong value" bad)) (newline)
(db:destroy! DIR)
