; scripts/vs_breakdown.aura — where an aura-rocks op spends its time
; (docs/vs-rocksdb.md). Runs bench.aura's fillrandom / readrandom /
; readseq / readmissing on a fresh DB with the default options, measures
; each total, then times the pieces the engine calls per op, separately and
; in this process, on that DB. "other" = total - measured pieces
; (db-bump! stats, option lookups, the obs window check, call glue).
; Env: BREAK_N (2000), BREAK_KEEP (comma list of kernels to install, "" = pure),
;      BREAK_TAG, BREAK_OUT (JSON lines appended).
(require "ru" all:)
(require "rio" all:)
(require "hot" all:)
(require "leaf" all:)
(require "entry" all:)
(require "wal" all:)
(require "bloom" all:)
(require "mem" all:)
(require "sst" all:)
(require "obs" all:)
(require "db" all:)
(require "rsink" all:)
(hot:load!)   ; top-level statement: see lib/hot.aura

(define (env-or k d) (let ((v (getenv k))) (if (and (string? v) (> (string-length v) 0)) v d)))
(define N (string->number (env-or "BREAK_N" "2000")))
(define KEEP (env-or "BREAK_KEEP" ""))
(define TAG (env-or "BREAK_TAG" (if (> (string-length KEEP) 0) "sink" "pure")))
(define OUT (env-or "BREAK_OUT" (string-append (ru:root) "/build/vs_breakdown.jsonl")))
(define kept (if (> (string-length KEEP) 0) (rsink:install-only! KEEP) (list)))
(rio:init!)
(define (now) (current-time-ms))
(define (row! op piece us)
  (rio:append! OUT (string-append "{\"tag\":\"" TAG "\",\"n\":" (number->string N) ",\"op\":\"" op "\",\"piece\":\"" piece "\",\"us\":" (number->string us) "}\n") #f)
  (display (string-append "  " op " / " piece ": ")) (display us) (newline))
(define (per reps thunk)
  (let ((t0 (now))) (let loop ((i 0)) (if (< i reps) (begin (thunk i) (loop (+ i 1))) #t)) (/ (* 1000.0 (- (now) t0)) reps)))

(define (key i) (string-append "user" (ru:pad i 12)))
(define value (list->string (let loop ((k 0) (acc (list))) (if (< k 100) (loop (+ k 1) (cons (integer->char (+ 97 (modulo (* k 7) 26))) acc)) acc))))
(define seed 301)
(define (rnd! m) (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648)) (modulo (quotient seed 16) m))
(define (perm n)
  (let ((v (make-vector n 0)))
    (let fill ((i 0)) (if (< i n) (begin (vector-set! v i i) (fill (+ i 1))) #t))
    (let shuf ((i (- n 1)))
      (if (> i 0) (let* ((j (rnd! (+ i 1))) (t (vector-ref v i))) (vector-set! v i (vector-ref v j)) (vector-set! v j t) (shuf (- i 1))) v))))
(define (stat db name) (cdr (assoc name (db:stats db))))

(display (string-append "vs_breakdown tag=" TAG " N=" (number->string N) " kept=")) (display kept) (newline)
(define DIR (string-append (ru:root) "/build/vs-break-" TAG))
(db:destroy! DIR)
(define db (db:open DIR #f))
(define order (perm N))
; ---- put: fillrandom
;; each put is timed; a put that triggered a flush (and maybe a compaction) has
;; its time minus the plain-put mean charged to flush / compaction.
(define t0 (now))
(define (nflush) (vector-ref (vector-ref db 6) 4))   ; db-stat-names: flushes
(define (ncomp) (vector-ref (vector-ref db 6) 5))    ; compactions
(define plain (list)) (define fl-ms 0) (define co-ms 0)
(let loop ((i 0))
  (if (< i N)
      (let ((f0 (nflush)) (c0 (ncomp)) (a (now)))
        (db:put! db (key (vector-ref order i)) value)
        (let ((dt (- (now) a)))
          (cond ((> (ncomp) c0) (set! co-ms (+ co-ms dt)))
                ((> (nflush) f0) (set! fl-ms (+ fl-ms dt)))
                (else (set! plain (cons dt plain)))))
        (loop (+ i 1)))
      #t))
(define put-total (/ (* 1000.0 (- (now) t0)) N))
(define (mean xs) (let loop ((xs xs) (s 0) (n 0)) (if (null? xs) (if (> n 0) (/ (* 1.0 s) n) 0) (loop (cdr xs) (+ s (car xs)) (+ n 1)))))
(define plain-ms (mean plain))
(define nfl (stat db "flushes")) (define nco (stat db "compactions"))
; puts that flushed and also compacted are all in co-ms: split by the flush-only average
(define fl-avg (if (> (- nfl nco) 0) (/ (- fl-ms (* (- nfl nco) plain-ms)) (- nfl nco)) 0))
(define flush-us (/ (* 1000.0 (+ (- fl-ms (* (- nfl nco) plain-ms)) (* nco fl-avg))) N))
(define compact-us (/ (* 1000.0 (- co-ms (* nco plain-ms) (* nco fl-avg))) N))
(define loop-us (per N (lambda (i) i)))
(define key-us (- (per N (lambda (i) (key (vector-ref order i)))) loop-us))
(define wp (string-append DIR "-wal.log"))
(rio:write wp "")
(define wal-us (- (per 500 (lambda (i) (wal:append! wp entry:put (key i) value #f))) loop-us))
(define mem-us (let ((m (mem:new "skiplist" 12))) (- (per 500 (lambda (i) (mem:put! m (key (vector-ref order i)) entry:put value))) loop-us)))
(define obs-us (- (per 500 (lambda (i) (obs:put! (db:obs db) (key i) #f 116 0))) loop-us))
(row! "fillrandom" "total" put-total)
(row! "fillrandom" "interpreter loop" loop-us)
(row! "fillrandom" "key build (bench harness)" key-us)
(row! "fillrandom" "WAL append (record encode + write(2))" wal-us)
(row! "fillrandom" "memtable insert (skiplist)" mem-us)
(row! "fillrandom" "observer (obs:put!)" obs-us)
(row! "fillrandom" "flush, amortized (mem:entries + SST build + open + manifest)" flush-us)
(row! "fillrandom" "compaction, amortized" compact-us)
(row! "fillrandom" "other" (- put-total loop-us key-us wal-us mem-us obs-us flush-us compact-us))
(db:flush! db)
(display (list "levels" (ru:len (db:level-files db 0)) (ru:len (db:level-files db 1)))) (newline)
; ---- get: readrandom (memtable empty after the flush)
(set! seed 7)
(set! t0 (now))
(let loop ((i 0)) (if (< i N) (begin (db:get db (key (rnd! N))) (loop (+ i 1))) #t))
(define get-total (/ (* 1000.0 (- (now) t0)) N))
(define tables (append (db:level-files db 0) (db:level-files db 1)))
; the tables a get probes, newest first, until a hit (sst:get checks the range itself)
(define (probe k) (let loop ((ts tables)) (if (null? ts) #f (let ((r (sst:get (car ts) k #t))) (if r r (loop (cdr ts)))))))
(define gkey-us (- (per N (lambda (i) (key (rnd! N)))) loop-us))
(define mget-us (- (per N (lambda (i) (mem:get (db:mem db) (key (rnd! N))))) loop-us gkey-us))
(define sget-us (- (per N (lambda (i) (probe (key (rnd! N))))) loop-us gkey-us))
(define t1 (car tables))
(define bloom-us (- (per N (lambda (i) (bloom:may? (vector-ref t1 6) (key (rnd! N))))) loop-us gkey-us))
(define gobs-us (- (per 500 (lambda (i) (obs:get! (db:obs db) (key i) "l1" #t 1 0))) loop-us))
(row! "readrandom" "total" get-total)
(row! "readrandom" "interpreter loop" loop-us)
(row! "readrandom" "key build (bench harness)" gkey-us)
(row! "readrandom" "memtable lookup (empty after flush)" mget-us)
(row! "readrandom" "table lookups: range + bloom + index + block read/verify + block-get" sget-us)
(row! "readrandom" "  of which bloom check (hash + probes, Soft)" bloom-us)
(row! "readrandom" "observer (obs:get!)" gobs-us)
(row! "readrandom" "other (level walk, stats, glue)" (- get-total loop-us gkey-us mget-us sget-us gobs-us))
; ---- readmissing
(set! t0 (now))
(let loop ((i 0)) (if (< i N) (begin (db:get db (string-append (key (rnd! N)) "x")) (loop (+ i 1))) #t))
(define miss-total (/ (* 1000.0 (- (now) t0)) N))
(define mkey-us (- (per N (lambda (i) (string-append (key (rnd! N)) "x"))) loop-us))
(define mbloom-us (- (per N (lambda (i) (probe (string-append (key (rnd! N)) "x")))) loop-us mkey-us))
(row! "readmissing" "total" miss-total)
(row! "readmissing" "interpreter loop" loop-us)
(row! "readmissing" "key build (bench harness)" mkey-us)
(row! "readmissing" "table lookups (range + bloom negative per table)" mbloom-us)
(row! "readmissing" "observer (obs:get!)" gobs-us)
(row! "readmissing" "other (memtable, level walk, stats, glue)" (- miss-total loop-us mkey-us mbloom-us gobs-us))
; ---- readseq: one db:scan of everything
(set! t0 (now))
(define scanned (ru:len (db:scan db "" #f #f)))
(define scan-total (/ (* 1000.0 (- (now) t0)) scanned))
(row! "readseq" "total (per entry)" scan-total)
(db:destroy! DIR)
