; scripts/profile.aura — where does the time go?  Times every engine
; component on its own (µs per call, in this process, on a real DB) and
; appends one JSON row per component to $PROFILE_OUT (build/profile.jsonl).
; PROFILE_SINK=1 runs the sink policy first (lib/rsink.aura), PROFILE_TAG
; labels the rows.
(require "ru" all:)
(require "rio" all:)
(require "hot" all:)
(require "leaf" all:)
(require "entry" all:)
(require "wal" all:)
(require "block" all:)
(require "bloom" all:)
(require "mem" all:)
(require "sst" all:)
(require "db" all:)
(require "cache" all:)
(require "obs" all:)
(require "adapt" all:)
(require "rsink" all:)
(require "plant" all:)
(require "score" all:)
(hot:load!)   ; top-level statement: see lib/hot.aura

(define (env-or k d) (let ((v (getenv k))) (if (and (string? v) (> (string-length v) 0)) v d)))
(define OUT (env-or "PROFILE_OUT" (string-append (ru:root) "/build/profile.jsonl")))
(define TAG (env-or "PROFILE_TAG" (if (equal? (env-or "PROFILE_SINK" "0") "1") "sink" "soft")))
(define plant (plant:real))
(score:set-rounds! 3)
(if (equal? (env-or "PROFILE_SINK" "0") "1")
    (rsink:sink-all! plant (rsink:samples) #f (string->number (env-or "SINK_MIN_SOFT_US" "50")) #f (string-append (ru:root) "/build/trajectory-profile.jsonl"))
    #f)

(define (prof name reps thunk)
  (let ((t0 (current-time-ms)))
    (let loop ((i 0)) (if (< i reps) (begin (thunk i) (loop (+ i 1))) #t))
    (let ((us (/ (* 1000.0 (- (current-time-ms) t0)) reps)))
      (rio:append! OUT (string-append "{\"tag\":\"" TAG "\",\"name\":\"" name "\",\"reps\":" (number->string reps) ",\"us\":" (number->string us) "}\n") #f)
      (display (string-append "  " name " ")) (display us) (newline)
      us)))

(define (key i) (string-append "user" (ru:pad i 12)))
(define value (list->string (let l ((k 0) (acc (list))) (if (< k 100) (l (+ k 1) (cons (integer->char (+ 97 (modulo (* k 7) 26))) acc)) acc))))
(define N 2000)
(define seed 5)
(define (rnd! m) (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648)) (modulo (quotient seed 16) m))

(display (string-append "profile tag=" TAG)) (newline)
(prof "empty-loop" 2000 (lambda (i) i))
; ---- leaves
(define rec (entry:encode entry:put (key 7) value))
(define blk (blk:build (let l ((i 0) (acc (list))) (if (< i 30) (l (+ i 1) (cons (entry:encode entry:put (key (* i 3)) value) acc)) (ru:rev acc)))))
(define bn (blk:count blk)) (define bra (blk:ra blk bn))
(prof "leaf:checksum 127B (wal rec)" 300 (lambda (i) (leaf:checksum rec 0 (string-length rec))))
(prof "leaf:checksum 4KB block" 20 (lambda (i) (leaf:checksum blk 0 (string-length blk))))
(prof "leaf:hash 16B" 500 (lambda (i) (leaf:hash (key i) 0)))
(prof "leaf:dec 6" 1000 (lambda (i) (leaf:dec rec 5 6)))
(prof "leaf:block-seek" 300 (lambda (i) (leaf:block-seek blk (key (* 3 (modulo i 30))) bn bra)))
(prof "ru:pad 12" 1000 (lambda (i) (ru:pad i 12)))
(prof "key (string-append+pad)" 1000 (lambda (i) (key i)))
; ---- write path pieces
(prof "entry:encode" 500 (lambda (i) (entry:encode entry:put (key i) value)))
(prof "wal:record" 300 (lambda (i) (wal:record entry:put (key i) value)))
(rio:init!)
(define wp (string-append (ru:root) "/build/profile-wal.log"))
(rio:write wp "")
(prof "rio:append! 130B" 300 (lambda (i) (rio:append! wp rec #f)))
(define (mem-put-prof rep)
  (let ((m (mem:new rep 14)))
    (prof (string-append "mem:put! " rep " (500 random)") 500 (lambda (i) (mem:put! m (key (rnd! 100000)) entry:put value)))
    (prof (string-append "mem:get " rep " (500 entries)") 300 (lambda (i) (mem:get m (key (rnd! 100000)))))
    (prof (string-append "mem:entries " rep " (flush view)") 3 (lambda (i) (mem:entries m)))))
(mem-put-prof "skiplist") (mem-put-prof "vector") (mem-put-prof "hash")
; ---- db
(define dir (string-append (ru:root) "/build/profile-db"))
(db:destroy! dir)
(define db (db:open dir (list (cons "memtable_bytes" 65536) (cons "l0_trigger" 4) (cons "target_file_bytes" 262144) (cons "block_bytes" 4096)
                              (cons "bloom_bits" 10) (cons "sync" #f) (cons "auto_compact" #t) (cons "obs_window" 200))))
(prof "db:put! (fillrandom, incl flush+compaction)" N (lambda (i) (db:put! db (key (rnd! N)) value)))
(define (stat name) (cdr (assoc name (db:stats db))))
(display (list "flush_ms" (stat "flush_ms") "compaction_ms" (stat "compaction_ms") "flushes" (stat "flushes") "compactions" (stat "compactions"))) (newline)
(rio:append! OUT (string-append "{\"tag\":\"" TAG "\",\"name\":\"fill flush_ms\",\"us\":" (number->string (stat "flush_ms")) "}\n{\"tag\":\"" TAG "\",\"name\":\"fill compaction_ms\",\"us\":" (number->string (stat "compaction_ms")) "}\n") #f)
(db:flush! db)
(define o (db:obs db))
(prof "obs:put!" 500 (lambda (i) (obs:put! o (key i) #f 120 0)))
(prof "db:get hit (sst)" 300 (lambda (i) (db:get db (key (rnd! N)))))
(prof "db:get miss" 300 (lambda (i) (db:get db (string-append (key (rnd! N)) "x"))))
(define t (sst:open (car (map sst:path (db:level-files db 1)))))
(define fl (vector-ref t 6))
(prof "bloom:may? (hash+probe)" 300 (lambda (i) (bloom:may? fl (key (rnd! N)))))
(prof "sst:get no-bloom (find+block+seek+decode)" 100 (lambda (i) (sst:get t (key (rnd! N)) #f)))
(prof "blk:count+ra" 500 (lambda (i) (blk:ra blk (blk:count blk))))
(prof "entry:val-at" 500 (lambda (i) (entry:val-at blk 0)))
(prof "entry:key-at" 500 (lambda (i) (entry:key-at blk 0)))
(prof "db:scan 10" 50 (lambda (i) (db:scan db (key (rnd! N)) #f 10)))
(prof "db:scan 100" 5 (lambda (i) (db:scan db (key (rnd! N)) #f 100)))
; ---- flush / compaction pieces
(define ents (let l ((i 0) (acc (list))) (if (< i 500) (l (+ i 1) (cons (list entry:put (key (* i 2)) value) acc)) (ru:rev acc))))
(prof "sst:write 500 entries (~60KB)" 2 (lambda (i) (sst:write (string-append (ru:root) "/build/profile-w.sst") ents 4096 10)))
(prof "sst:open 60KB" 3 (lambda (i) (sst:open (string-append (ru:root) "/build/profile-w.sst"))))
(prof "bloom:build 500 keys" 2 (lambda (i) (bloom:build (map (lambda (e) (car (cdr e))) ents) 10)))
(prof "db:compact! (2000 keys)" 1 (lambda (i) (db:compact! db)))
; ---- controller
(define trace (let l ((i 0) (acc (list))) (if (< i 256) (l (+ i 1) (cons (cons (if (< (rnd! 10) 7) 0 2) (key (rnd! N))) acc)) acc)))
(define ctl (adapt:new #f (list "memtable_rep") #f))
(prof "cache:simulate lru 512 (cap 12)" 2 (lambda (i) (cache:simulate "lru" 12 (map (lambda (x) (cdr x)) (append trace trace)))))
(prof "cache:simulate lfu 512 (cap 12)" 2 (lambda (i) (cache:simulate "lfu" 12 (map (lambda (x) (cdr x)) (append trace trace)))))
(db:destroy! dir)
