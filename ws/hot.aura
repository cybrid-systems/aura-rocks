;; ---- Coarse leaves (aura-kernel-sink policy:sink-c!, C in kernels/rocks_leaves.c).
;; Each body is the specification: the shadow-gate oracle and the fallback
;; when the C kernel refuses an input. Plain Aura (not the vkgen subset).

;; Zero-padded decimal field of width w (error if it does not fit).
(define rk-pad
  (lambda (n w)
    (let ((s (number->string n)))
      (if (> (string-length s) w)
          (error (string-append "aura-rocks: field overflow: " s " does not fit " (number->string w) " digits"))
          (letrec ((loop (lambda (s) (if (< (string-length s) w) (loop (string-append "0" s)) s)))) (loop s))))))

;; Entry: type(1) klen(4) vlen(6) key value; type 68 = D (tombstone), else P.
(define rk-entry-encode
  (lambda (type key val)
    (if (> (string-length key) 9999) (error "aura-rocks: key longer than 9999") #f)
    (if (> (string-length val) 999999) (error "aura-rocks: value longer than 999999") #f)
    (string-append (if (= type 68) "D" "P") (rk-pad (string-length key) 4) (rk-pad (string-length val) 6) key val)))

;; WAL record: "R" len(8) adler32(10) entry.
(define rk-wal-record
  (lambda (type key val)
    (let ((p (rk-entry-encode type key val)))
      (string-append "R" (rk-pad (string-length p) 8) (rk-pad (rk-checksum p 0 (string-length p)) 10) p))))

;; Data block from encoded entries back to back: entries, a 6-digit offset per
;; entry (restart array), count(6).
(define rk-block-build
  (lambda (blob)
    (letrec ((loop (lambda (off n offs)
               (if (>= off (string-length blob))
                   (string-append blob (apply string-append (reverse offs)) (rk-pad n 6))
                   (loop (+ off 11 (rk-dec blob (+ off 1) 4) (rk-dec blob (+ off 5) 6)) (+ n 1) (cons (rk-pad off 6) offs))))))
      (loop 0 0 (list)))))

;; Bloom filter over the keys in keyblob (klen(4) key, back to back), the
;; filter lib/bloom.aura always built: nbits(10) k(2) then 6-bit digits
;; (char 48+v). The blob is walked as a char list once (string-ref is
;; O(index), aura#4548).
(define rk-bloom-build
  (lambda (blob bpk)
    (letrec ((num (lambda (cs w v) (if (= w 0) v (num (cdr cs) (- w 1) (+ (* v 10) (- (char->integer (car cs)) 48))))))
             (drop (lambda (cs n) (if (= n 0) cs (drop (cdr cs) (- n 1)))))
             (take (lambda (cs n acc) (if (= n 0) (list->string (reverse acc)) (take (cdr cs) (- n 1) (cons (car cs) acc)))))
             (hashes (lambda (cs acc)
                       (if (null? cs) acc
                           (let* ((kl (num cs 4 0)) (kcs (drop cs 4)))
                             (hashes (drop kcs kl) (cons (rk-hash (take kcs kl (list)) 0) acc)))))))
      (let* ((hs (hashes (string->list blob) (list)))
             (nkeys (length hs))
             (nbits (if (> (* nkeys bpk) 64) (* nkeys bpk) 64))
             (nchars (quotient (+ nbits 5) 6))
             (k (let ((x (quotient (* bpk 69) 100))) (if (< x 1) 1 (if (> x 30) 30 x))))
             (v (make-vector nchars 0)))
        (letrec ((pow2 (lambda (b) (if (= b 0) 1 (if (= b 1) 2 (if (= b 2) 4 (if (= b 3) 8 (if (= b 4) 16 32)))))))
                 (probe (lambda (i p d)
                          (if (< i k)
                              (let* ((ci (quotient p 6)) (bit (pow2 (modulo p 6))) (cur (vector-ref v ci)))
                                (if (= (modulo (quotient cur bit) 2) 0) (vector-set! v ci (+ cur bit)) #f)
                                (probe (+ i 1) (modulo (+ p d) nbits) d))
                              #t)))
                 (each (lambda (hs) (if (null? hs) #t
                                        (let ((h (car hs))) (probe 0 (modulo h nbits) (+ (quotient h 131072) (* (modulo h 131072) 32768))) (each (cdr hs))))))
                 (out (lambda (i acc) (if (< i 0) acc (out (- i 1) (cons (integer->char (+ 48 (vector-ref v i))) acc))))))
          (each hs)
          (string-append (rk-pad nbits 10) (rk-pad k 2) (list->string (out (- nchars 1) (list)))))))))

;; Filter check of one key: hash + probes (1 maybe, 0 no).
(define rk-bloom-may
  (lambda (bits nbits k key)
    (rk-bloom-probe bits nbits (rk-hash key 0) k)))

;; Point lookup in a data block: "" when absent, else the type char followed
;; by the value.
(define rk-block-get
  (lambda (blk key)
    (let* ((n (rk-dec blk (- (string-length blk) 6) 6))
           (ra (- (string-length blk) 6 (* 6 n)))
           (i (rk-block-seek blk key n ra)))
      (if (>= i n) ""
          (let* ((off (rk-dec blk (+ ra (* 6 i)) 6)) (kl (rk-dec blk (+ off 1) 4)) (vl (rk-dec blk (+ off 5) 6)))
            (if (string=? (substring blk (+ off 11) (+ off 11 kl)) key)
                (string-append (substring blk off (+ off 1)) (substring blk (+ off 11 kl) (+ off 11 kl vl)))
                ""))))))

;; Cache policy simulation (lib/cache.aura rules) on a "\n"-separated access
;; trace: hits of policy (0 lru, 1 lfu, 2 clock) at capacity cap, cold start.
(define rk-cache-sim
  (lambda (policy cap trace)
    (if (<= cap 0) 0
        (let ((table (make-hash)) (keys (make-vector cap #f)) (stamps (make-vector cap 0)) (sfreq (make-vector cap 0))
              (refs (make-vector cap 0)) (hist (vector (make-hash) 0)) (st (vector 0 0 0 0)))
          (letrec ((href (lambda (h k d) (let ((v (hash-ref h k))) (if (null? v) d v))))
                   (count! (lambda (k)
                             (let* ((h (vector-ref hist 0)) (f (href h k 0)))
                               (if (= f 0)
                                   (if (>= (vector-ref hist 1) (* 16 cap))
                                       (let ((h2 (make-hash))) (vector-set! hist 0 h2) (vector-set! hist 1 1) (hash-set! h2 k 1) 1)
                                       (begin (vector-set! hist 1 (+ 1 (vector-ref hist 1))) (hash-set! h k 1) 1))
                                   (begin (hash-set! h k (+ f 1)) (+ f 1))))))
                   (touch! (lambda (s) (vector-set! st 2 (+ 1 (vector-ref st 2))) (vector-set! stamps s (vector-ref st 2)) (vector-set! refs s 1)))
                   (clock (lambda (h c)
                            (if (and (= (vector-ref refs h) 1) (< c (* 2 cap)))
                                (begin (vector-set! refs h 0) (clock (modulo (+ h 1) cap) (+ c 1)))
                                (begin (vector-set! st 1 (modulo (+ h 1) cap)) h))))
                   (lfu (lambda (i best)
                          (if (>= i cap) best
                              (lfu (+ i 1) (if (or (< (vector-ref sfreq i) (vector-ref sfreq best))
                                                   (and (= (vector-ref sfreq i) (vector-ref sfreq best)) (< (vector-ref stamps i) (vector-ref stamps best))))
                                               i best)))))
                   (lru (lambda (i best) (if (>= i cap) best (lru (+ i 1) (if (< (vector-ref stamps i) (vector-ref stamps best)) i best)))))
                   (victim (lambda () (if (= policy 2) (clock (vector-ref st 1) 0) (if (= policy 1) (lfu 1 0) (lru 1 0)))))
                   (access! (lambda (k)
                              (let* ((f (count! k)) (s (href table k -1)))
                                (if (>= s 0)
                                    (begin (vector-set! st 3 (+ 1 (vector-ref st 3))) (touch! s) (vector-set! sfreq s f))
                                    (let ((s2 (if (< (vector-ref st 0) cap)
                                                  (let ((n (vector-ref st 0))) (vector-set! st 0 (+ n 1)) n)
                                                  (let ((v (victim))) (hash-remove! table (vector-ref keys v)) v))))
                                      (hash-set! table k s2) (vector-set! keys s2 k) (touch! s2)
                                      (vector-set! sfreq s2 (let ((f2 (href (vector-ref hist 0) k 0))) (if (> f2 0) f2 1))))))))
                   (split (lambda (cs acc)
                            (cond ((null? cs) (if (null? acc) #f (access! (list->string (reverse acc)))))
                                  ((= (car cs) 10) (begin (access! (list->string (reverse acc))) (split (cdr cs) (list))))
                                  (else (split (cdr cs) (cons (car cs) acc)))))))
            (split (string->list trace) (list))
            (vector-ref st 3))))))

;; Kernel slots for the rebind path (aura-kernel-sink policy:sink!, vkgen):
;; sink-kernel-<name> holds the C kernel and <name> a wrapper. aura-rocks now
;; uses host slots (lib/leaf.aura); tests/test_leaf.aura still rebinds.
(define sink-kernel-rk-checksum 0)
(define sink-kernel-rk-hash 0)
(define sink-kernel-rk-bloom-probe 0)
(define sink-kernel-rk-dec 0)
(define sink-kernel-rk-block-seek 0)
(define sink-kernel-rk-pad 0)
(define sink-kernel-rk-entry-encode 0)
(define sink-kernel-rk-wal-record 0)
(define sink-kernel-rk-block-build 0)
(define sink-kernel-rk-bloom-build 0)
(define sink-kernel-rk-bloom-may 0)
(define sink-kernel-rk-block-get 0)
(define sink-kernel-rk-cache-sim 0)

;; Sink control plane (aura-kernel-sink reads it; hot-swappable).
(define (sink-min-speedup) 1.5)
;; Adaptive structure policy (lib/adapt.aura). The engine reads these through
;; lib/leaf.aura; the controller changes one with mutate:rebind, keeps it when
;; the gate passes, and rolls it back with hot-strategy:heal! otherwise.
(define (rk-memtable-rep) "skiplist")
(define (rk-compaction-style) "leveled")
(define (rk-l0-trigger) 4)
(define (rk-max-runs) 4)
(define (rk-cache-policy) "lru")
(define (rk-bloom-reads) 1)
