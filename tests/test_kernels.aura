; tests/test_kernels.aura — every C kernel in kernels/rocks_leaves.c against
; its Aura define in ws/hot.aura: randomized and edge-case inputs through the
; lib/leaf.aura entry points (kernel installed) vs the rk-* define, and the
; raw kernel must answer (not refuse) on ordinary engine data.
(require "expect" all:)
(require "ru" all:)
(require "hot" all:)
(require "leaf" all:)
(require "rsink" all:)
(require "csink" all:)
(require "entry" all:)
(require "block" all:)
(require "bloom" all:)
(require "sst" all:)
(require "rio" all:)
(display "RUN-ONCE") (newline)
(hot:load!)
(define SINKED (rsink:install-all!))
(expect "all 14 kernels installed" (= (length SINKED) 14))
(define seed 11)
(define (rnd! m) (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648)) (modulo (quotient seed 65536) m))
(define (rstr n) (let loop ((i 0) (acc (list))) (if (< i n) (loop (+ i 1) (cons (integer->char (+ 33 (rnd! 90))) acc)) (list->string acc))))
(define bad 0)
(define (same! tag a b) (if (equal? a b) #t (begin (set! bad (+ bad 1)) (if (< bad 10) (begin (display "MISMATCH ") (display tag) (display " ") (write a) (display " vs ") (write b) (newline)) #f) #f)))
(define (sv th) (try (list (th)) (catch (e) "error")))
; random sorted block of n entries, its blob, its keys
(define (rkeys n) (let loop ((i 0) (acc (list))) (if (< i n) (loop (+ i 1) (cons (string-append "k" (ru:pad (* i 3) 5) (rstr (rnd! 4))) acc)) (ru:rev acc))))
(define (rblock ks) (blk:build (map (lambda (k) (entry:encode (if (= (rnd! 5) 0) entry:del entry:put) k (rstr (rnd! 30)))) ks)))
(define ROUNDS 40)
(let loop ((r 0))
  (if (< r ROUNDS)
      (let* ((s (rstr (rnd! 200))) (L (string-length s)) (a (rnd! (+ L 1))) (b (+ a (rnd! (+ (- L a) 1))))
             (ks (rkeys (+ 1 (rnd! 40)))) (blk (rblock ks)) (n (blk:count blk)) (ra (blk:ra blk n))
             (probe (if (= (rnd! 2) 0) (list-ref ks (rnd! (length ks))) (rstr (+ 1 (rnd! 9)))))
             (kb (bloom:keyblob ks)) (bpk (+ 1 (rnd! 16))) (filt (leaf:bloom-build kb bpk)) (pf (bloom:parse filt))
             (tr (let t ((i 0) (acc (rstr 3))) (if (< i (rnd! 300)) (t (+ i 1) (string-append acc "\n" (list-ref ks (rnd! (length ks))))) acc))))
        (same! "checksum" (sv (lambda () (leaf:checksum s a b))) (sv (lambda () (rk-checksum s a b))))
        (same! "hash" (sv (lambda () (leaf:hash s r))) (sv (lambda () (rk-hash s r))))
        (let ((o (rnd! 8)) (w (rnd! 8))) (same! "dec2" (sv (lambda () (leaf:dec "0012345678901234" o w))) (sv (lambda () (rk-dec "0012345678901234" o w)))))
        (same! "block-seek" (sv (lambda () (leaf:block-seek blk probe n ra))) (sv (lambda () (rk-block-seek blk probe n ra))))
        (let ((v (rnd! 100000)) (w (+ 1 (rnd! 8)))) (same! "pad" (sv (lambda () (leaf:pad v w))) (sv (lambda () (rk-pad v w)))))
        (let ((t (if (= (rnd! 2) 0) 68 80)))
          (same! "entry-encode2" (sv (lambda () (leaf:entry-encode t probe s))) (sv (lambda () (rk-entry-encode t probe s))))
          (same! "wal-record" (sv (lambda () (leaf:wal-record t probe s))) (sv (lambda () (rk-wal-record t probe s)))))
        (let ((blob (substring blk 0 ra))) (same! "block-build" (sv (lambda () (leaf:block-build blob))) (sv (lambda () (rk-block-build blob)))))
        (same! "bloom-build" (sv (lambda () filt)) (sv (lambda () (rk-bloom-build kb bpk))))
        (same! "bloom-may" (sv (lambda () (leaf:bloom-may (car pf) (car (cdr pf)) (car (cdr (cdr pf))) probe)))
               (sv (lambda () (rk-bloom-may (car pf) (car (cdr pf)) (car (cdr (cdr pf))) probe))))
        (same! "block-get" (sv (lambda () (leaf:block-get blk probe))) (sv (lambda () (rk-block-get blk probe))))
        (let ((pol (rnd! 3)) (cap (rnd! 20)))
          (same! "cache-sim" (sv (lambda () (leaf:cache-sim pol cap tr))) (sv (lambda () (rk-cache-sim pol cap tr)))))
        (loop (+ r 1)))
      #t))
(expect "randomized: every kernel entry point equals its Aura define" (= bad 0))
;; whole tables: random sorted entry blobs (tombstones included), random
;; block size / bits per key, merges of 1-4 overlapping tables
(define (rtab ks) (ru:concat (map (lambda (k) (entry:encode (if (= (rnd! 4) 0) entry:del entry:put) k (rstr (rnd! 60)))) ks)))
(define (rsub ks) (let loop ((ks ks) (acc (list))) (if (null? ks) (ru:rev acc) (loop (cdr ks) (if (= (rnd! 2) 0) (cons (car ks) acc) acc)))))
(define (rfile ks bb bpk) (let ((t (rk-sst-build (rtab (if (null? ks) (list "k") ks)) bb bpk))) (string-append (ru:pad (string-length t) 12) t)))
(let loop ((r 0))
  (if (< r 6)
      (let* ((ks (rkeys (+ 1 (rnd! 80)))) (bb (+ 64 (rnd! 2000))) (bpk (+ 1 (rnd! 16))) (b (rtab ks))
             (nf (+ 1 (rnd! 4)))
             (files (let f ((i 0) (acc "")) (if (< i nf) (f (+ i 1) (string-append acc (rfile (rsub ks) bb bpk))) acc)))
             (bottom (rnd! 2)) (target (+ 1 (rnd! 3000))))
        (same! "sst-build" (sv (lambda () (leaf:sst-build b bb bpk))) (sv (lambda () (rk-sst-build b bb bpk))))
        (same! "sst-merge" (sv (lambda () (leaf:sst-merge files bottom target bb bpk))) (sv (lambda () (rk-sst-merge files bottom target bb bpk))))
        (expect "raw sst kernels answer" (and (string? (leaf:sst-build-k b bb bpk)) (string? (leaf:sst-merge-k files bottom target bb bpk))))
        (loop (+ r 1)))
      #t))
(expect "randomized: table kernels equal their Aura defines" (= bad 0))
; the engine's module path (sst:write without the kernel) writes the same bytes
(let* ((es (map (lambda (k) (list entry:put k (rstr 20))) (rkeys 50))) (d (ru:path (ru:root) "build/test-kernels")))
  (rio:mkdir! d)
  (sst:write (ru:path d "a.sst") es 512 10)
  (leaf:install! "rk-sst-build" #f)
  (sst:write (ru:path d "b.sst") es 512 10)
  (expect "sst:write kernel == module path" (equal? (rio:read (ru:path d "a.sst")) (rio:read (ru:path d "b.sst")))))
; a corrupted block: the kernel refuses, the Aura define reports corruption
(let* ((f (rfile (rkeys 30) 256 10)) (bad (string-append (substring f 0 20) (if (equal? (substring f 20 21) "x") "y" "x") (substring f 21 (string-length f)))))
  (expect "merge: corrupted input refused by the kernel" (not (leaf:sst-merge-k bad 1 1000 256 10)))
  (expect "merge: corrupted input -> corruption error" (equal? (sv (lambda () (rk-sst-merge bad 1 1000 256 10))) "error")))
; edge cases (refusals fall back to the Aura define, including its errors)
(define (edge tag th1 th2) (expect (string-append "edge " tag) (equal? (sv th1) (sv th2))))
(edge "checksum empty range" (lambda () (leaf:checksum "abc" 2 1)) (lambda () (rk-checksum "abc" 2 1)))
(edge "pad overflow" (lambda () (leaf:pad 1234567 6)) (lambda () (rk-pad 1234567 6)))
(edge "entry key too long" (lambda () (leaf:entry-encode 80 (make-string 10000 #\a) "v")) (lambda () (rk-entry-encode 80 (make-string 10000 #\a) "v")))
(edge "non-ascii value" (lambda () (leaf:wal-record 80 "k" "caf\u00e9")) (lambda () (rk-wal-record 80 "k" "caf\u00e9")))
(edge "cache-sim empty" (lambda () (leaf:cache-sim 0 4 "")) (lambda () (rk-cache-sim 0 4 "")))
(edge "cache-sim cap 0" (lambda () (leaf:cache-sim 1 0 "a\nb")) (lambda () (rk-cache-sim 1 0 "a\nb")))
(edge "block-get empty block" (lambda () (leaf:block-get "000000" "a")) (lambda () (rk-block-get "000000" "a")))
; the raw kernels answer on engine data (no silent fallback)
(define (raw name) (let loop ((ks (rsink:kernels)))
  (if (equal? (car (car ks)) name)
      (csink:load (csink:build! (string-append (ru:root) "/kernels/rocks_leaves.c") (list-ref (car ks) 1)) (list-ref (car ks) 1) (list-ref (car ks) 2) (list-ref (car ks) 3))
      (loop (cdr ks)))))
(define blk1 (rblock (rkeys 20)))
(expect "raw rk_wal_record answers" (string? ((raw "rk-wal-record") 80 "key" 3 "val" 3)))
(expect "raw rk_block_get answers" (string? ((raw "rk-block-get") blk1 (string-length blk1) "k00003" 6)))
(expect "raw rk_checksum answers" (exact? ((raw "rk-checksum") blk1 (string-length blk1) 0 (string-length blk1))))
(expect "raw rk_cache_sim answers" (exact? ((raw "rk-cache-sim") 1 2 "a\nb\na" 5)))
(expect "checks all passed" (expect-summary))
