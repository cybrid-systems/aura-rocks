; tests/test_sst.aura — SST write/open/get/iterate, bloom skip, corruption.
(require "expect" all:)
(require "ru" all:)
(require "rio" all:)
(require "hot" all:)
(require "entry" all:)
(require "sst" all:)
(display "RUN-ONCE") (newline)
(rio:init!)
(hot:load!)
(define tmp (string-append (ru:root) "/build/test-sst"))
(shell (string-append "rm -rf " tmp " && mkdir -p " tmp))
(define (mkkey i) (string-append "key" (ru:pad i 6)))
; 300 keys (even numbers), every 7th a tombstone; ~100-byte values -> many blocks
(define (val i) (string-append "value-" (number->string i) "-" (make-string-of 90 i)))
(define (make-string-of n i) (list->string (let loop ((k 0) (acc (list))) (if (< k n) (loop (+ k 1) (cons (integer->char (+ 97 (modulo (+ i k) 26))) acc)) acc))))
(define ents (let loop ((i 299) (acc (list)))
               (if (< i 0) acc
                   (loop (- i 1) (cons (if (= (modulo i 7) 0) (list entry:del (mkkey (* 2 i)) "") (list entry:put (mkkey (* 2 i)) (val i))) acc)))))
(define path (string-append tmp "/000001.sst"))
(define meta (sst:write path ents 4096 10))
(expect "write: count + bounds" (and (= (car (cdr meta)) 300) (equal? (car (cdr (cdr (cdr meta)))) (mkkey 0)) (equal? (car (cdr (cdr (cdr (cdr meta))))) (mkkey 598))))
(define t (sst:open path))
(display "blocks: ") (display (sst:nblocks t)) (display " bytes: ") (display (sst:size t)) (newline)
(expect "open: many blocks" (> (sst:nblocks t) 5))
(expect "file is 7-bit text" (ru:ascii? (rio:read path)))
(define (get i) (sst:get t (mkkey i) #t))
(expect "get every key (put/tombstone)"
        (let loop ((i 0))
          (cond ((>= i 300) #t)
                ((let ((h (get (* 2 i)))) (if (= (modulo i 7) 0) (and h (= (car h) entry:del)) (and h (= (car h) entry:put) (equal? (cdr h) (val i))))) (loop (+ i 1)))
                (else (display "bad ") (display i) (newline) #f))))
(sst:stats-reset!)
(expect "absent keys (odd) -> #f" (let loop ((i 0)) (cond ((>= i 150) #t) ((get (+ 1 (* 2 i))) #f) (else (loop (+ i 1))))))
(define st (sst:stats))
(display "bloom stats on 150 misses: ") (display st) (newline)
(expect "bloom rejects most absent keys" (> (cdr (car (cdr st))) 130))
(expect "out of range -> #f without bloom" (and (not (sst:get t "a" #t)) (not (sst:get t "z" #t))))
; iterator: full scan + seek
(define it (sst:iter-first! (sst:iter t)))
(define all (let loop ((acc (list))) (if (sst:iter-valid? it) (let ((k (sst:iter-key it))) (sst:iter-next! it) (loop (cons k acc))) (ru:rev acc))))
(expect "iterate: all 300 keys in order" (and (= (ru:len all) 300) (equal? (car all) (mkkey 0)) (equal? (car (ru:rev all)) (mkkey 598))))
(define it2 (sst:iter-seek! (sst:iter t) (mkkey 501)))
(expect "seek between keys -> next key" (equal? (sst:iter-key it2) (mkkey 502)))
(sst:iter-next! it2)
(expect "next after seek" (equal? (sst:iter-key it2) (mkkey 504)))
(expect "seek past end -> invalid" (not (sst:iter-valid? (sst:iter-seek! (sst:iter t) "zzz"))))
; corruption: flip one byte inside the first data block -> error, not a wrong answer
(define data (rio:read path))
(define cpath (string-append tmp "/000002.sst"))
(rio:write cpath (string-append (substring data 0 40) (if (= (string-ref data 40) 97) "b" "a") (substring data 41 (string-length data))))
(define ct (sst:open cpath))
(expect "corrupt block -> error on read" (equal? (try (sst:get ct (mkkey 0) #t) (catch (e) "corruption")) "corruption"))
(rio:write cpath (substring data 0 (- (string-length data) 1)))
(expect "truncated file -> error on open" (equal? (try (sst:open cpath) (catch (e) "bad")) "bad"))
(expect "checks all passed" (expect-summary))
