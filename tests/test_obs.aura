; tests/test_obs.aura — workload observer (lib/obs.aura) through the engine.
(require "expect" all:)
(require "ru" all:)
(require "hot" all:)
(require "rsink" all:)
(require "db" all:)
(require "obs" all:)
(hot:load!)   ; top-level statement: see lib/hot.aura
; $ROCKS_TEST_SINK=1: every leaf runs its C kernel (lib/rsink.aura install-all)
(define SINKED (if (equal? (getenv "ROCKS_TEST_SINK") "1") (rsink:install-all!) (list)))
(if (equal? (getenv "ROCKS_TEST_SINK") "1") (begin (display "sink: installed ") (display (length SINKED)) (newline)) #f)
(display "RUN-ONCE") (newline)
(define dir (string-append (ru:root) "/build/test-obs"))
(db:destroy! dir)
(define (opts) (list (cons "memtable_bytes" 2500) (cons "l0_trigger" 3) (cons "target_file_bytes" 8000)
                     (cons "block_bytes" 1024) (cons "bloom_bits" 10) (cons "sync" #f) (cons "auto_compact" #t)
                     (cons "obs_window" 40)))
(define db (db:open dir (opts)))
(define o (db:obs db))
(define (f name) (obs:feature o name))
(define (key i) (string-append "user" (ru:pad i 4)))
(define (val i) (string-append "value-" (number->string i) "-payload-payload"))
; phase 1: sequential inserts only
(let loop ((i 0)) (if (< i 120) (begin (db:put! db (key i) (val i)) (loop (+ i 1))) #t))
(display (obs:features o)) (newline)
(expect "3 windows closed after 120 ops" (= (obs:windows o) 3))
(expect "write-only: write_ratio 1" (= (f "write_ratio") 1.0))
(expect "sequential inserts: seq_ratio near 1" (> (f "seq_ratio") 0.95))
(expect "write_amp > 0 after flushes" (> (f "write_amp") 0.5))
; phase 2: random reads of existing keys, then misses
(define seed 11)
(define (rnd! m) (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648)) (modulo (quotient seed 65536) m))
(let loop ((i 0)) (if (< i 80) (begin (db:get db (key (rnd! 120))) (loop (+ i 1))) #t))
(display (obs:features o)) (newline)
(expect "read phase: read_ratio > 0.8" (> (f "read_ratio") 0.8))
(expect "read phase: hits come from SST levels" (> (+ (f "hit_l0") (f "hit_l1")) 0.5))
(expect "read phase: read_amp >= 1" (>= (f "read_amp") 1.0))
(expect "read phase: few misses" (< (f "miss_rate") 0.2))
(let loop ((i 0)) (if (< i 80) (begin (db:get db (string-append "nokey" (number->string i))) (loop (+ i 1))) #t))
(expect "miss phase: miss_rate > 0.8" (> (f "miss_rate") 0.8))
; phase 3: scans
(let loop ((i 0)) (if (< i 40) (begin (db:scan db (key (* i 2)) #f 5) (loop (+ i 1))) #t))
(display (obs:features o)) (newline)
(expect "scan phase: scan_share > 0.5" (> (f "scan_share") 0.5))
(expect "scan phase: scan_len 5" (= (f "scan_len") 5.0))
; phase 4: random overwrites -> seq_ratio drops
(let loop ((i 0)) (if (< i 80) (begin (db:put! db (key (rnd! 120)) "x") (loop (+ i 1))) #t))
(expect "random writes: seq_ratio < 0.7" (< (f "seq_ratio") 0.7))
(expect "trace keeps the last 256 ops" (= (ru:len (obs:trace o)) 256))
(expect "trace last op is the last put" (equal? (car (car (ru:rev (obs:trace o)))) 0))
(expect "checks all passed" (expect-summary))
