; tests/test_units.aura — hot leaves, entry codec, WAL, memtable, bloom, block.
(require "expect" all:)
(require "ru" all:)
(require "rio" all:)
(require "hot" all:)
(require "entry" all:)
(require "wal" all:)
(require "memtable" all:)
(require "bloom" all:)
(require "block" all:)
(display "RUN-ONCE") (newline)
(rio:init!)
(hot:load!)
(define tmp (string-append (ru:root) "/build/test-units"))
(shell (string-append "rm -rf " tmp " && mkdir -p " tmp))

; ---- hot leaves
(expect "adler32 of Wikipedia" (= (rk-checksum "Wikipedia" 0 9) 300286872))
(expect "adler32 of a slice" (= (rk-checksum "xxWikipediayy" 2 11) 300286872))
(expect "adler32 empty = 1" (= (rk-checksum "abc" 1 1) 1))
(expect "hash deterministic, seed matters" (and (= (rk-hash "k1" 0) (rk-hash "k1" 0)) (not (= (rk-hash "k1" 0) (rk-hash "k1" 1)))))
(expect "hash 32-bit" (let ((h (rk-hash "some longer key with bytes ~~~" 7))) (and (>= h 0) (< h 4294967296))))
(expect "dec" (and (= (rk-dec "ab000123" 2 6) 123) (= (rk-dec "9" 0 1) 9)))

; ---- entry codec
(define e1 (entry:encode entry:put "key1" "value-1"))
(expect "entry layout" (equal? e1 "P0004000007key1value-1"))
(expect "entry fields" (and (= (entry:type-at e1 0) entry:put) (equal? (entry:key-at e1 0) "key1") (equal? (entry:val-at e1 0) "value-1")
                            (= (entry:size-at e1 0) (string-length e1))))
(expect "tombstone encodes D" (= (entry:type-at (entry:encode entry:del "k" "") 0) entry:del))

; ---- WAL: append, replay, torn tail, corrupt record
(define wp (string-append tmp "/w.log"))
(wal:append! wp entry:put "a" "1" #f)
(wal:append! wp entry:put "b" "22" #t)
(wal:append! wp entry:del "a" "" #f)
(define seen (list))
(define r (wal:replay wp (lambda (t k v) (set! seen (cons (list t k v) seen)))))
(expect "wal replays 3 records in order" (and (= (car r) 3) (equal? (ru:rev seen) (list (list entry:put "a" "1") (list entry:put "b" "22") (list entry:del "a" "")))))
(define whole (rio:read wp))
(rio:write wp (substring whole 0 (- (string-length whole) 3)))
(set! seen (list))
(set! r (wal:replay wp (lambda (t k v) (set! seen (cons k seen)))))
(expect "wal torn tail dropped, prefix kept" (and (= (car r) 2) (equal? seen (list "b" "a"))))
; flip one payload byte of record 2 ("22" -> "2X")
(define rec1 (wal:record entry:put "a" "1"))
(define bad (string-append rec1 (let ((x (wal:record entry:put "b" "22"))) (string-append (substring x 0 (- (string-length x) 1)) "X")) rec1))
(rio:write wp bad)
(set! r (wal:replay wp (lambda (t k v) #t)))
(expect "wal stops at checksum mismatch" (= (car r) 1))
(expect "wal missing file -> 0 records" (= (car (wal:replay (string-append tmp "/none.log") (lambda (t k v) #t))) 0))
(expect "io mode" (or (equal? (rio:mode) "ffi") (equal? (rio:mode) "pure")))

; ---- memtable
(define m (mt:new))
(define (lcg x) (modulo (+ (* x 1103515245) 12345) 2147483648))
(define (mkkey i) (string-append "k" (ru:pad i 6)))
(let loop ((i 0) (x 42)) (if (< i 600) (begin (mt:put! m (mkkey (modulo x 1000)) entry:put (number->string i)) (loop (+ i 1) (lcg x))) #t))
(define ks (map (lambda (e) (car (cdr e))) (mt:entries m)))
(define (sorted? xs) (or (null? xs) (null? (cdr xs)) (and (string<? (car xs) (car (cdr xs))) (sorted? (cdr xs)))))
(expect "memtable iterates strictly sorted" (sorted? ks))
(expect "memtable count = distinct keys" (= (mt:count m) (ru:len ks)))
(mt:put! m "k000500" entry:put "x")
(mt:put! m "k000500" entry:put "y")
(expect "memtable overwrite in place" (equal? (mt:val m (mt:get m "k000500")) "y"))
(mt:put! m "k000500" entry:del "")
(expect "memtable tombstone" (= (mt:type m (mt:get m "k000500")) entry:del))
(expect "memtable miss" (not (mt:get m "zzz")))
(expect "memtable seek lower bound" (let ((x (mt:seek m "k0005001"))) (or (< x 0) (string<? "k0005001" (mt:key m x)))))
(expect "memtable bytes grow" (> (mt:bytes m) 0))

; ---- bloom
(define bkeys (let loop ((i 0) (acc (list))) (if (< i 500) (loop (+ i 1) (cons (mkkey (* i 2)) acc)) acc)))
(define f (bloom:build bkeys 10))
(define pf (bloom:parse f))
(expect "bloom: no false negatives" (let loop ((ks bkeys)) (cond ((null? ks) #t) ((bloom:may? pf (car ks)) (loop (cdr ks))) (else #f))))
(define fp (let loop ((i 0) (n 0)) (if (< i 500) (loop (+ i 1) (if (bloom:may? pf (mkkey (+ 1 (* i 2)))) (+ n 1) n)) n)))
(display "bloom false positives /500: ") (display fp) (newline)
(expect "bloom: false positive rate < 5%" (< fp 25))
(expect "bloom: filter is 7-bit text" (ru:ascii? f))

; ---- block
(define ents (map (lambda (k) (entry:encode entry:put k (string-append "v" k))) (list "apple" "banana" "cherry" "date")))
(define b (blk:build ents))
(define n (blk:count b))
(define ra (blk:ra b n))
(expect "block count" (= n 4))
(expect "block seek exact/between/before/after"
        (and (= (blk:seek b "banana" n ra) 1) (= (blk:seek b "bb" n ra) 2) (= (blk:seek b "" n ra) 0) (= (blk:seek b "zz" n ra) 4)
             (= (blk:seek b "apple0" n ra) 1) (= (blk:seek b "appl" n ra) 0)))
(expect "block decode" (let ((off (blk:off b ra 2))) (and (equal? (blk:key b off) "cherry") (equal? (blk:val b off) "vcherry"))))
(expect "checks all passed" (expect-summary))
