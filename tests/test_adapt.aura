; tests/test_adapt.aura — memtable rep switching by the controller
; (lib/adapt.aura): hot rebind of rk-memtable-rep, shadow-replay gate, swap at
; the rotation boundary and live, post-check rollback, JSON trajectory rows;
; the engine answers match an oracle throughout.
(require "expect" all:)
(require "ru" all:)
(require "rio" all:)
(require "hot" all:)
(require "rsink" all:)
(require "leaf" all:)
(require "db" all:)
(require "obs" all:)
(require "adapt" all:)
(hot:load!)   ; top-level statement: see lib/hot.aura
; $ROCKS_TEST_SINK=1: every leaf runs its C kernel (lib/rsink.aura install-all)
(define SINKED (if (equal? (getenv "ROCKS_TEST_SINK") "1") (rsink:install-all!) (list)))
(if (equal? (getenv "ROCKS_TEST_SINK") "1") (begin (display "sink: installed ") (display (length SINKED)) (newline)) #f)
(display "RUN-ONCE") (newline)
(define dir (string-append (ru:root) "/build/test-adapt"))
(define traj (string-append (ru:root) "/build/test-adapt.jsonl"))
(db:destroy! dir)
(rio:unlink! traj)
(define (opts) (list (cons "memtable_bytes" 3000) (cons "l0_trigger" 4) (cons "target_file_bytes" 20000)
                     (cons "block_bytes" 1024) (cons "bloom_bits" 10) (cons "sync" #f) (cons "auto_compact" #t)
                     (cons "obs_window" 50) (cons "memtable_rep" #f) (cons "prefix_len" 7)))
(expect "workspace starts with the skiplist rep" (equal? (adapt:knob "memtable_rep") "skiplist"))
; 1. the hot swap itself
(adapt:set-knob! "memtable_rep" "hash")
(expect "set-knob! rebinds rk-memtable-rep" (equal? (leaf:memtable-rep) "hash"))
(expect "leaf calls unaffected by the rebind" (= (leaf:dec "123" 0 3) 123))
(adapt:set-knob! "memtable_rep" "skiplist")
(define db (db:open dir (opts)))
(define (stat name) (let loop ((s (db:stats db))) (cond ((null? s) #f) ((equal? (car (car s)) name) (cdr (car s))) (else (loop (cdr s))))))
(define ctl (adapt:new traj (list "memtable_rep") #f))
(adapt:attach! ctl db "test")
(define NK 400)
(define oracle (make-vector NK #f))
(define (key i) (string-append "user" (ru:pad i 4)))
(define (put! i v) (db:put! db (key i) v) (vector-set! oracle i v))
(define seed 3)
(define (rnd! m) (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648)) (modulo (quotient seed 65536) m))
(define bad 0)
(define (get! i) (if (equal? (db:get db (key i)) (vector-ref oracle i)) #f (set! bad (+ bad 1))))
; 2. write-only sequential phase: the next memtable should be a vector
(let loop ((i 0)) (if (< i 300) (begin (put! i (string-append "v" (number->string i) "-payload-payload")) (loop (+ i 1))) #t))
(display (adapt:summary ctl)) (newline)
(expect "write phase: switched to vector at a rotation (SWAP row)" (equal? (adapt:knob "memtable_rep") "vector"))
(expect "write phase: the live memtable is a vector now" (equal? (stat "mem_rep") "vector"))
; 3. point-read heavy phase with some writes: hash, live migration on
(define ctl2 (adapt:new traj (list "memtable_rep") #t))
(adapt:attach! ctl2 db "test-live")
(let loop ((n 0)) (if (< n 300) (begin (if (< (rnd! 10) 2) (put! (rnd! 300) (string-append "w" (number->string n))) (get! (rnd! 300))) (loop (+ n 1))) #t))
(display (adapt:summary ctl2)) (newline)
(expect "read phase: switched live to hash" (equal? (stat "mem_rep") "hash"))
(expect "read phase: every get matched the oracle" (= bad 0))
; 4. post check: make any regression count, then a scan-heavy phase
(adapt:set-param! ctl2 "max_regress" 0.0)
(adapt:set-param! ctl2 "similar" 10.0)
(let loop ((n 0)) (if (< n 300) (begin (let ((r (rnd! 10))) (cond ((< r 4) (db:scan db (key (rnd! 300)) #f 5)) ((< r 8) (put! (rnd! 300) (string-append "s" (number->string n) "-payload-payload-payload"))) (else (get! (rnd! 300))))) (loop (+ n 1))) #t))
(display (adapt:summary ctl2)) (newline)
(define (has-row? c d stage) (let loop ((rs (adapt:rows c))) (cond ((null? rs) #f) ((and (equal? (cdr (assoc "decision" (car rs))) d) (equal? (cdr (assoc "stage" (car rs))) stage)) #t) (else (loop (cdr rs))))))
(expect "post check rolled a swap back (ROLLBACK row)" (has-row? ctl2 "ROLLBACK" "post"))
(expect "after rollback the knob matches the live memtable" (equal? (adapt:knob "memtable_rep") (stat "mem_rep")))
(expect "scan phase: every get matched the oracle" (= bad 0))
(define (oracle-pairs lo hi)
  (let loop ((i (- hi 1)) (acc (list))) (if (< i lo) acc (loop (- i 1) (if (vector-ref oracle i) (cons (cons (key i) (vector-ref oracle i)) acc) acc)))))
(expect "full scan == oracle after all switches" (equal? (db:scan db "" #f #f) (oracle-pairs 0 NK)))
; 5. trajectory: one JSON object per line with state, action, reward
(define lines (let loop ((s (rio:read traj)) (i 0) (start 0) (acc (list)))
  (cond ((>= i (string-length s)) (ru:rev acc)) ((= (string-ref s i) 10) (loop s (+ i 1) (+ i 1) (cons (substring s start i) acc))) (else (loop s (+ i 1) start acc)))))
(expect "trajectory rows written" (> (ru:len lines) 2))
(expect "every row parses as JSON with knob/decision/reward/features"
  (let loop ((ls lines)) (if (null? ls) #t (let ((h (json-parse (car ls)))) (if (and (hash-ref h "knob" #f) (hash-ref h "decision" #f) (number? (hash-ref h "reward" #f)) (hash-ref h "features" #f)) (loop (cdr ls)) #f)))))
(adapt:set-knob! "memtable_rep" "skiplist")
; 6. compaction style switching: write-heavy -> tiered (+ higher L0 trigger),
; read-heavy -> leveled (+ one full compaction down to a single run)
(define dir2 (string-append (ru:root) "/build/test-adapt2"))
(db:destroy! dir2)
(define (opts2) (list (cons "memtable_bytes" 3000) (cons "target_file_bytes" 20000) (cons "block_bytes" 1024) (cons "bloom_bits" 10)
                      (cons "sync" #f) (cons "auto_compact" #t) (cons "obs_window" 50) (cons "memtable_rep" "skiplist") (cons "prefix_len" 7)))
(set! db (db:open dir2 (opts2)))
(define ctl3 (adapt:new traj (list "compaction") #f))
(adapt:attach! ctl3 db "test-compaction")
(adapt:set-param! ctl3 "collapse_on_leveled" 1)   ; (the default; 0 leaves the runs to the next compaction)
(define oracle2 (make-vector NK #f))
(define (put2! i v) (db:put! db (key i) v) (vector-set! oracle2 i v))
(let loop ((n 0)) (if (< n 500) (begin (put2! (rnd! NK) (string-append "c" (number->string n) "-payload-payload")) (loop (+ n 1))) #t))
(display (adapt:summary ctl3)) (newline) (display (db:stats db)) (newline)
(expect "write phase: compaction style tiered" (equal? (stat "compaction_style") "tiered"))
(expect "write phase: L0 trigger raised to 8" (= (adapt:knob "l0_trigger") 8))
(define bad2 0)
(let loop ((n 0)) (if (< n 200) (begin (if (equal? (db:get db (key (rnd! NK))) #f) #f #f)
                                        (let ((i (rnd! NK))) (if (equal? (db:get db (key i)) (vector-ref oracle2 i)) #f (set! bad2 (+ bad2 1))))
                                        (loop (+ n 1))) #t))
(display (adapt:summary ctl3)) (newline) (display (db:stats db)) (newline)
(expect "read phase: compaction style leveled" (equal? (stat "compaction_style") "leveled"))
(expect "read phase: one run after the switch" (<= (stat "runs") 1))
(expect "every get matched the oracle across compaction switches" (= bad2 0))
(adapt:set-knob! "compaction_style" "leveled") (adapt:set-knob! "l0_trigger" 4) (adapt:set-knob! "max_runs" 4)
(expect "checks all passed" (expect-summary))
