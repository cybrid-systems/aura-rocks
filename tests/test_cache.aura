; tests/test_cache.aura — block cache policies (lib/cache.aura), live policy
; switching, and the cache / bloom-reads knobs through the engine.
(require "expect" all:)
(require "ru" all:)
(require "rio" all:)
(require "hot" all:)
(require "db" all:)
(require "cache" all:)
(require "adapt" all:)
(hot:load!)   ; top-level statement: see lib/hot.aura
(display "RUN-ONCE") (newline)
; ---- unit: eviction choices
(define (fill! c keys) (for-each (lambda (k) (if (not (cache:get c k)) (cache:put! c k (string-append "v" k)) #f)) keys))
(define c1 (cache:new "lru" 3 64))
(fill! c1 (list "a" "b" "c" "a" "d"))         ; lru evicts b
(expect "lru: a kept" (equal? (cache:get c1 "a") "va"))
(expect "lru: b evicted" (not (cache:get c1 "b")))
(define c2 (cache:new "lfu" 3 64))
(fill! c2 (list "a" "a" "a" "b" "b" "c" "d"))  ; lfu evicts c (freq 1, oldest of the freq-1s)
(expect "lfu: a kept" (equal? (cache:get c2 "a") "va"))
(expect "lfu: c evicted" (not (cache:get c2 "c")))
(expect "lfu: b kept" (equal? (cache:get c2 "b") "vb"))
(define c3 (cache:new "clock" 3 64))
(fill! c3 (list "a" "b" "c" "d"))
(expect "clock: capacity respected" (= (cache:count c3) 3))
(expect "clock: d present" (equal? (cache:get c3 "d") "vd"))
; live switch keeps contents
(cache:set-policy! c1 "lfu")
(expect "switch keeps contents" (equal? (cache:get c1 "a") "va"))
(expect "policy switched" (equal? (cache:policy c1) "lfu"))
(expect "trace records accesses" (> (ru:len (cache:trace c1)) 5))
; simulation: a hot set interleaved with one-touch scan blocks favours lfu over lru
(define (hot-scan n)
  (let loop ((i 0) (acc (list)))
    (if (>= i n) (ru:rev acc)
        (loop (+ i 1) (cons (string-append "s" (number->string i)) (cons (string-append "h" (number->string (remainder i 3))) acc))))))
(define tr (hot-scan 60))
(define hl (cache:simulate "lru" 4 tr))
(define hf (cache:simulate "lfu" 4 tr))
(display (list "sim lru" hl "lfu" hf (cache:simulate "clock" 4 tr))) (newline)
(expect "scan-polluted trace: lfu hits > lru hits" (> hf hl))
; ---- engine: cached blocks, policy from the workspace, bloom knob
(define dir (string-append (ru:root) "/build/test-cache"))
(db:destroy! dir)
(define (opts) (list (cons "memtable_bytes" 2500) (cons "l0_trigger" 3) (cons "target_file_bytes" 8000)
                     (cons "block_bytes" 512) (cons "bloom_bits" 10) (cons "sync" #f) (cons "auto_compact" #t)
                     (cons "obs_window" 40) (cons "block_cache_blocks" 8)))
(define db (db:open dir (opts)))
(define (key i) (string-append "user" (ru:pad i 4)))
(define (val i) (string-append "value-" (number->string i) "-payload-payload"))
(let loop ((i 0)) (if (< i 200) (begin (db:put! db (key i) (val i)) (loop (+ i 1))) #t))
(define (all-ok?) (let loop ((i 0)) (cond ((>= i 200) #t) ((equal? (db:get db (key i)) (val i)) (loop (+ i 1))) (else #f))))
(define (st name) (cdr (assoc name (db:stats db))))
(expect "values correct with cache" (all-ok?))
(expect "values correct on re-read (cached)" (all-ok?))
(expect "cache has hits" (> (st "cache_hits") 0))
(expect "cache policy from workspace: lru" (equal? (st "cache_policy") "lru"))
(mutate:rebind "rk-cache-policy" "(lambda () \"clock\")" "test")
(eval-current)
(let loop ((i 0)) (if (< i 40) (begin (db:get db (key i)) (loop (+ i 1))) #t))
(expect "policy follows workspace at window close" (equal? (st "cache_policy") "clock"))
(expect "values correct under clock" (all-ok?))
(expect "bloom reads on by default" (= (st "bloom_reads") 1))
(mutate:rebind "rk-bloom-reads" "(lambda () 0)" "test")
(eval-current)
(expect "bloom reads off" (= (st "bloom_reads") 0))
(define bc0 (st "bloom_checks"))
(expect "values correct without bloom" (all-ok?))
(expect "misses correct without bloom" (not (db:get db "zzzz-missing")))
(expect "no bloom checks while off" (= bc0 (st "bloom_checks")))
(mutate:rebind "rk-bloom-reads" "(lambda () 1)" "test")
(mutate:rebind "rk-cache-policy" "(lambda () \"lru\")" "test")
(eval-current)
; ---- controller: cache policy switch on a scan-polluted workload, bloom knob
(db:flush! db)
(db:compact! db)
(define traj (string-append (ru:root) "/build/test-cache-traj.jsonl"))
(shell (string-append "rm -f '" traj "'"))
(define ctl (adapt:new traj (list "cache_policy" "bloom_reads") #f))
(adapt:attach! ctl db "test-cache")
(adapt:set-param! ctl "cmp_periods" 1)
(adapt:set-param! ctl "cache_every" 1)
(adapt:set-param! ctl "max_regress" 100.0)
(define seed 7)
(define (rnd! m) (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648)) (modulo (quotient seed 65536) m))
(define hot-ok #t)
(let loop ((n 0))
  (if (< n 160)
      (begin
        (if (= 0 (remainder n 2))
            (let ((i (* 12 (rnd! 6)))) (if (equal? (db:get db (key i)) (val i)) #f (set! hot-ok #f)))
            (db:scan db (key (rnd! 170)) #f 30))
        (loop (+ n 1)))
      #t))
(define (rows-of k) (let loop ((rs (adapt:rows ctl)) (acc (list))) (if (null? rs) (ru:rev acc) (loop (cdr rs) (if (equal? (cdr (assoc "knob" (car rs))) k) (cons (car rs) acc) acc)))))
(display (adapt:summary ctl)) (newline)
(expect "hot reads correct during scans" hot-ok)
(expect "values correct after cache switching" (all-ok?))
(let loop ((n 0)) (if (< n 160) (begin (db:get db (key (rnd! 200))) (loop (+ n 1))) #t))
(expect "bloom: switched off on an all-hit read phase" (= 0 (adapt:knob "bloom_reads")))
(let loop ((n 0)) (if (< n 160) (begin (db:get db (string-append "nokey" (number->string n))) (loop (+ n 1))) #t))
(expect "bloom: back on when reads miss" (= 1 (adapt:knob "bloom_reads")))
(expect "misses correct" (not (db:get db "nokey-final")))
(define cache-rows (rows-of "cache_policy"))
(expect "cache: a gated SWAP lru -> lfu" (let loop ((rs cache-rows)) (cond ((null? rs) #f) ((and (equal? (cdr (assoc "decision" (car rs))) "SWAP") (equal? (cdr (assoc "to" (car rs))) "lfu")) #t) (else (loop (cdr rs))))))
(expect "cache: live policy is the knob" (equal? (cache:policy (db:cache db)) (adapt:knob "cache_policy")))
(expect "cache: swap row carries simulated hits" (let ((r (car cache-rows))) (pair? (cdr (assoc "sim_hits" r)))))
(expect "trajectory written" (> (string-length (rio:read traj)) 100))
(display (adapt:summary ctl)) (newline)
(db:set-hook! db #f)
(adapt:set-knob! "cache_policy" "lru")
(adapt:set-knob! "bloom_reads" 1)
(expect "checks all passed" (expect-summary))
