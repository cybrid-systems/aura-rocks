; tests/test_mem.aura — memtable reps (lib/mem.aura) against an oracle:
; random puts/deletes/gets interleaved with seeks and full iteration (the
; vector rep's sorted view must be rebuilt after every write), then migrate.
(require "expect" all:)
(require "ru" all:)
(require "entry" all:)
(require "mem" all:)
(display "RUN-ONCE") (newline)
(define NK 300)
(define (key i) (string-append "k" (ru:pad i 5)))
(define seed 5)
(define (rnd! m) (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648)) (modulo (quotient seed 65536) m))
; oracle: #f absent, (type . val)
(define (oracle-seek o k) (let loop ((i 0)) (cond ((>= i NK) #f) ((and (vector-ref o i) (not (string<? (key i) k))) i) (else (loop (+ i 1))))))
(define (check-rep! rep)
  (let ((m (mem:new rep 4)) (o (make-vector NK #f)) (bad 0) (t0 (current-time-ms)))
    (let loop ((n 0))
      (if (< n 900)
          (let ((i (rnd! NK)) (r (rnd! 10)))
            (cond ((< r 5) (mem:put! m (key i) entry:put (number->string n)) (vector-set! o i (cons entry:put (number->string n))))
                  ((< r 6) (mem:put! m (key i) entry:del "") (vector-set! o i (cons entry:del "")))
                  ((< r 9) (if (equal? (mem:get m (key i)) (vector-ref o i)) #f (set! bad (+ bad 1))))
                  (else (let* ((k (string-append (key i) "5")) (c (mem:cur-seek! (mem:cursor m) k)) (j (oracle-seek o k)))
                          (if (if j (and (mem:cur-valid? c) (equal? (mem:cur-key c) (key j))) (not (mem:cur-valid? c))) #f (set! bad (+ bad 1))))))
            (loop (+ n 1)))
          #t))
    (display (list rep "900 mixed ops ms" (- (current-time-ms) t0) "count" (mem:count m) "bytes" (mem:bytes m))) (newline)
    (expect (string-append rep ": gets and seeks match the oracle") (= bad 0))
    (let ((want (let loop ((i (- NK 1)) (acc (list))) (if (< i 0) acc (loop (- i 1) (if (vector-ref o i) (cons (list (car (vector-ref o i)) (key i) (cdr (vector-ref o i))) acc) acc))))))
      (expect (string-append rep ": entries in key order == oracle (tombstones kept)") (equal? (mem:entries m) want))
      (let each ((rs (mem:reps)))
        (if (null? rs) #t
            (begin (expect (string-append rep " -> " (car rs) ": migrate keeps entries") (equal? (mem:entries (mem:migrate m (car rs) 3)) want))
                   (each (cdr rs))))))
    (expect (string-append rep ": miss") (not (mem:get m "zzz")))))
(check-rep! "skiplist")
(check-rep! "vector")
(check-rep! "hash")
; write-only bulk: put cost per rep
(define (bulk rep n) (let ((m (mem:new rep 4)) (t0 (current-time-ms)))
  (let loop ((i 0)) (if (< i n) (begin (mem:put! m (key (modulo (* i 7) n)) entry:put "v") (loop (+ i 1))) #t))
  (let ((t1 (current-time-ms))) (mem:entries m) (display (list rep "bulk puts" n "ms" (- t1 t0) "sorted iterate ms" (- (current-time-ms) t1))) (newline))))
(bulk "skiplist" 500) (bulk "vector" 500) (bulk "hash" 500)
(expect "checks all passed" (expect-summary))
