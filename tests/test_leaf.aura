; tests/test_leaf.aura — guard for the aura#4547 workaround (workspace loaded
; by a top-level (hot:load!) statement, not at module load): after a rebind or
; a heal of any hot leaf, every leaf:* call reaches the CURRENT body of its
; own define, never another define.
(require "expect" all:)
(require "hot" all:)
(require "leaf" all:)
(require "std/hot-strategy" all:)
(require "discover" all:)
(hot:load!)
(display "RUN-ONCE") (newline)
(define (calls) (list (leaf:checksum "a" 0 1) (leaf:hash "a" 0) (leaf:bloom-probe "o" 6 3 2) (leaf:dec "123" 0 3) (leaf:block-seek "x" "a" 0 0)))
(define orig (calls))
(expect "leaf calls before any mutation" (equal? orig (list 6422626 2816415817 1 123 0)))
; rebind one leaf at a time to a marker, check all five, restore it
(define (marker-test! name body marker k)
  (hot-strategy:register! name (car (hot-src name)))
  (mutate:rebind name body "test-leaf")
  (eval-current)
  (let ((got (calls)))
    (expect (string-append "rebind " name ": its leaf:* sees the new body")
            (equal? (list-ref got k) marker))
    (expect (string-append "rebind " name ": the other leaf:* calls are unchanged")
            (let loop ((i 0)) (cond ((= i 5) #t) ((or (= i k) (equal? (list-ref got i) (list-ref orig i))) (loop (+ i 1))) (else #f)))))
  (hot-strategy:heal!)
  (expect (string-append "heal " name ": all leaf:* calls back to the originals") (equal? (calls) orig)))
; original body text of a workspace define (for the rollback point)
(define (hot-src name) (let f ((ds (discover:defines (discover:scan)))) (if (string=? (car (car ds)) name) (list (discover:write (car (cdr (car ds))))) (f (cdr ds)))))
(marker-test! "rk-checksum" "(lambda (s a b) 1001)" 1001 0)
(marker-test! "rk-hash" "(lambda (s seed) 1002)" 1002 1)
(marker-test! "rk-bloom-probe" "(lambda (b n h k) 1003)" 1003 2)
(marker-test! "rk-dec" "(lambda (s o w) 1004)" 1004 3)
(marker-test! "rk-block-seek" "(lambda (b k n r) 1005)" 1005 4)
(expect "checks all passed" (expect-summary))
