; tests/test_db.aura — engine end to end: put/get/delete, flush, L0 -> L1
; compaction, scans, WAL recovery, randomized ops against an oracle.
(require "expect" all:)
(require "ru" all:)
(require "rio" all:)
(require "entry" all:)
(require "db" all:)
(require "hot" all:)
(require "rsink" all:)
(hot:load!)   ; top-level statement: see lib/hot.aura (aura#4546, aura#4547)
; $ROCKS_TEST_SINK=1: every leaf runs its C kernel (lib/rsink.aura install-all)
(define SINKED (if (equal? (getenv "ROCKS_TEST_SINK") "1") (rsink:install-all!) (list)))
(if (equal? (getenv "ROCKS_TEST_SINK") "1") (begin (display "sink: installed ") (display (length SINKED)) (newline)) #f)
(display "RUN-ONCE") (newline)
; one dir per config and mode: the configs may run in parallel
(define dir (string-append (ru:root) "/build/test-db-" (let ((r (getenv "ROCKS_TEST_REP"))) (if (and (string? r) (> (string-length r) 0)) (list->string (map (lambda (c) (if (equal? c #\:) #\- c)) (string->list r))) "default"))
                           (if (equal? (getenv "ROCKS_TEST_SINK") "1") "-sink" "")))
(db:destroy! dir)
; memtable rep under test: $ROCKS_TEST_REP (scripts/run_tests.sh runs this
; file once per rep: skiplist, vector, hash)
; $ROCKS_TEST_REP = "<memtable rep>:<compaction style>"
(define CFG (let ((r (getenv "ROCKS_TEST_REP"))) (if (and (string? r) (> (string-length r) 0)) r "skiplist:leveled")))
(define (cfg-split s) (let loop ((i 0)) (if (= (string-ref s i) 58) (cons (substring s 0 i) (substring s (+ i 1) (string-length s))) (loop (+ i 1)))))
(define REP (car (cfg-split CFG)))
(define STYLE (cdr (cfg-split CFG)))
(display (string-append "memtable rep " REP ", compaction " STYLE)) (newline)
; small sizes so a few hundred keys exercise flush + compaction
(define (opts) (list (cons "memtable_bytes" 2500) (cons "l0_trigger" 3) (cons "target_file_bytes" 8000)
                     (cons "block_bytes" 1024) (cons "bloom_bits" 10) (cons "sync" #f) (cons "auto_compact" #t)
                     (cons "memtable_rep" REP) (cons "prefix_len" 7) (cons "compaction_style" STYLE) (cons "max_runs" 3)))
(define db (db:open dir (opts)))
(define (stat name) (let loop ((s (db:stats db))) (cond ((null? s) #f) ((equal? (car (car s)) name) (cdr (car s))) (else (loop (cdr s))))))

(db:put! db "hello" "world")
(expect "get after put (memtable)" (equal? (db:get db "hello") "world"))
(db:put! db "hello" "there")
(expect "overwrite" (equal? (db:get db "hello") "there"))
(db:delete! db "hello")
(expect "delete -> #f" (not (db:get db "hello")))
(expect "missing -> #f" (not (db:get db "nope")))

; ---- randomized ops vs oracle (vector indexed by key number; #f = absent)
(define NK 120)
(define oracle (make-vector NK #f))
(define (key i) (string-append "user" (ru:pad i 4)))
(define (valf i n) (string-append "v" (number->string n) "-" (key i) "-payload-payload-payload"))
(define seed 7)
(define (rnd! m) (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648)) (modulo (quotient seed 65536) m))
(define (apply-op! n)
  (let ((i (rnd! NK)) (r (rnd! 10)))
    (if (< r 7)
        (begin (db:put! db (key i) (valf i n)) (vector-set! oracle i (valf i n)))
        (begin (db:delete! db (key i)) (vector-set! oracle i #f)))))
(let loop ((n 0)) (if (< n 500) (begin (apply-op! n) (loop (+ n 1))) #t))
(display "stats: ") (display (db:stats db)) (newline)
(expect "flushes happened" (> (stat "flushes") 2))
(expect "compaction happened" (> (stat "compactions") 0))
(expect (string-append "memtable rep is " REP) (equal? (stat "mem_rep") REP))
(expect (string-append "compaction style is " STYLE) (equal? (stat "compaction_style") STYLE))
(if (equal? STYLE "tiered") (expect "tiered: several sorted runs live" (>= (stat "runs") 2)) #f)
(define (check-all! label)
  (let loop ((i 0) (bad 0))
    (if (< i NK)
        (loop (+ i 1) (if (equal? (db:get db (key i)) (vector-ref oracle i)) bad (begin (display "mismatch ") (display (key i)) (newline) (+ bad 1))))
        (expect (string-append label ": every key matches the oracle") (= bad 0)))))
(check-all! "random ops")
; full scan == oracle in key order
(define (oracle-pairs lo hi)
  (let loop ((i (- hi 1)) (acc (list))) (if (< i lo) acc (loop (- i 1) (if (vector-ref oracle i) (cons (cons (key i) (vector-ref oracle i)) acc) acc)))))
(expect "scan everything == oracle" (equal? (db:scan db "" #f #f) (oracle-pairs 0 NK)))
(expect "scan [user0030, user0060) == oracle" (equal? (db:scan db (key 30) (key 60) #f) (oracle-pairs 30 60)))
(expect "scan limit 5" (equal? (db:scan db (key 10) #f 5) (let loop ((xs (oracle-pairs 10 NK)) (n 0) (acc (list))) (if (or (null? xs) (= n 5)) (ru:rev acc) (loop (cdr xs) (+ n 1) (cons (car xs) acc))))))

; ---- recovery: reopen (memtable rebuilt from the WAL)
(define mem-before (stat "mem_entries"))
(db:close db)
(set! db (db:open dir (opts)))
(display "after reopen: ") (display (db:stats db)) (newline)
(expect "WAL replayed the memtable" (and (> mem-before 0) (> (stat "wal_records_replayed") 0) (= (stat "mem_entries") mem-before)))
(check-all! "after reopen")
; more writes after recovery, then a manual flush + compaction
(let loop ((n 500)) (if (< n 650) (begin (apply-op! n) (loop (+ n 1))) #t))
(db:flush! db)
(db:compact! db)
(expect "after compaction: L0 empty" (= (stat "l0_files") 0))
(expect "after full compaction: one run" (= (stat "runs") 1))
(check-all! "after compact")
(expect "scan after compact == oracle" (equal? (db:scan db "" #f #f) (oracle-pairs 0 NK)))
; recovery again with an empty memtable
(set! db (db:open dir (opts)))
(check-all! "reopen after compact")
; torn WAL tail: append garbage, reopen: the good prefix survives
(db:put! db (key 1) "last-good")
(vector-set! oracle 1 "last-good")
(rio:append! (db:wal-path db) "R0000" #f)
(set! db (db:open dir (opts)))
(expect "torn WAL tail ignored, earlier record kept" (equal? (db:get db (key 1)) "last-good"))
; live migration of the memtable to every other rep keeps every answer
(let loop ((n 650)) (if (< n 700) (begin (apply-op! n) (loop (+ n 1))) #t))
(let each ((rs (list "skiplist" "vector" "hash" REP)))
  (if (null? rs) #t
      (begin (db:migrate-mem! db (car rs))
             (check-all! (string-append "after live migrate to " (car rs)))
             (expect (string-append "scan after live migrate to " (car rs)) (equal? (db:scan db "" #f #f) (oracle-pairs 0 NK)))
             (each (cdr rs)))))
(expect "only 7-bit files on disk" (let loop ((fs (rio:list dir))) (cond ((null? fs) #t) ((ru:ascii? (rio:read (string-append dir "/" (car fs)))) (loop (cdr fs))) (else #f))))
(expect "checks all passed" (expect-summary))
