; tests/test_native.aura — differential test: the native data plane
; (lib/ndb.aura -> native/rk_native.c) against the pure-Aura reference engine
; (lib/db.aura), same options, same randomized ops: put / delete / batch /
; get / multiget / ranged scans with limits / flush / full compaction /
; reopen (WAL replay) / live option changes. Every answer is compared.
; Runs once per memtable rep x compaction style ($ROCKS_TEST_REP).
(require "expect" all:)
(require "ru" all:)
(require "db" all:)
(require "hot" all:)
(require "ndb" all:)
(hot:load!)   ; top-level statement: see lib/hot.aura
(display "RUN-ONCE") (newline)
(define CFG (let ((r (getenv "ROCKS_TEST_REP"))) (if (and (string? r) (> (string-length r) 0)) r "skiplist:leveled")))
(define (cfg-split s) (let loop ((i 0)) (if (= (string-ref s i) 58) (cons (substring s 0 i) (substring s (+ i 1) (string-length s))) (loop (+ i 1)))))
(define REP (car (cfg-split CFG)))
(define STYLE (cdr (cfg-split CFG)))
(define CACHE (cond ((equal? REP "vector") "lru") ((equal? REP "hash") "clock") (else "lfu")))
(display (string-append "native vs reference: rep " REP ", compaction " STYLE ", cache " CACHE)) (newline)
(define (opts) (list (cons "memtable_bytes" 2500) (cons "l0_trigger" 3) (cons "target_file_bytes" 8000)
                     (cons "block_bytes" 1024) (cons "bloom_bits" 10) (cons "sync" #f) (cons "auto_compact" #t)
                     (cons "memtable_rep" REP) (cons "prefix_len" 7) (cons "compaction_style" STYLE) (cons "max_runs" 3)
                     (cons "block_cache_blocks" 6) (cons "cache_policy" CACHE) (cons "bloom_reads" 1)))
(define tag (list->string (map (lambda (c) (if (equal? c #\:) #\- c)) (string->list CFG))))
(define rdir (string-append (ru:root) "/build/test-native-ref-" tag))
(define ndir (string-append (ru:root) "/build/test-native-nat-" tag))
(db:destroy! rdir) (ndb:destroy! ndir)
(define R (db:open rdir (opts)))
(define N (ndb:open ndir (opts)))
(define seed 4242)
(define (rnd! m) (set! seed (modulo (+ (* seed 1103515245) 12345) 2147483648)) (modulo (quotient seed 16) m))
(define (key i) (string-append "k" (substring (number->string (+ 1000 i)) 1 4)))
(define (val i) (string-append "v" (number->string i) "-" (number->string (rnd! 100000))))
(define mismatches 0)
(define (same? what a b)
  (if (equal? a b) #t
      (begin (set! mismatches (+ mismatches 1))
             (if (< mismatches 6) (begin (display (list "MISMATCH" what "ref" a "native" b)) (newline)) #f)
             #f)))
(define gets 0) (define scans 0) (define batches 0) (define reopens 0)
(define (step! i)
  (let ((w (rnd! 100)) (k (key (rnd! 300))))
    (cond ((< w 40) (let ((v (val i))) (db:put! R k v) (ndb:put! N k v)))
          ((< w 50) (db:delete! R k) (ndb:delete! N k))
          ((< w 55) (let* ((k2 (key (rnd! 300))) (v (val i)) (ops (list (list "put" k v) (list "del" k2) (list "put" k2 v))))
                      (db:put! R k v) (db:delete! R k2) (db:put! R k2 v) (ndb:write! N ops) (set! batches (+ batches 1))))
          ((< w 75) (set! gets (+ gets 1)) (same? (list "get" k) (db:get R k) (ndb:get N k)))
          ((< w 80) (let ((ks (list k (key (rnd! 300)) (key (rnd! 300)))))
                      (same? (list "multiget" ks) (map (lambda (x) (db:get R x)) ks) (ndb:multi-get N ks))))
          ((< w 88) (let* ((a (rnd! 300)) (s (key a)) (e (if (= (rnd! 3) 0) #f (key (+ a (rnd! 60))))) (lim (if (= (rnd! 2) 0) #f (+ 1 (rnd! 20)))))
                      (set! scans (+ scans 1))
                      (same? (list "scan" s e lim) (db:scan R s e lim) (ndb:scan N s e lim))))
          ((< w 91) (db:flush! R) (ndb:flush! N))
          ((< w 92) (db:compact! R) (ndb:compact! N))
          ((< w 94) (ndb:close N) (set! N (ndb:open ndir (opts))) (set! reopens (+ reopens 1)))
          (else (same? (list "get" k) (db:get R k) (ndb:get N k))))))
(let loop ((i 0)) (if (< i 400) (begin (step! i) (loop (+ i 1))) #t))
(expect "randomized ops: every get / multiget / scan answer equals the reference" (= mismatches 0))
(expect "full scan equals the reference" (same? "full scan" (db:scan R "" #f #f) (ndb:scan N "" #f #f)))
(expect "exercised: gets, scans, batches, reopens" (and (> gets 50) (> scans 10) (> batches 5) (> reopens 2)))
(define st (ndb:stats N))
(define (sv k) (cdr (assoc k st)))
(display (list "native" "flushes" (sv "flushes") "compactions" (sv "compactions") "runs" (sv "runs") "l0" (sv "l0_files") "cache hits" (sv "cache_hits") "bloom negatives" (sv "bloom_negatives"))) (newline)
(expect "native invariants (runs sorted, non-overlapping)" (= (ndb:check N) 0))
(expect "stats report the configured structure" (and (equal? (sv "mem_rep") REP) (equal? (sv "compaction_style") STYLE) (equal? (sv "cache_policy") CACHE)))
; recovery: unflushed writes come back from the WAL
(ndb:put! N "zz-wal" "survives") (db:put! R "zz-wal" "survives")
(ndb:close N)
(set! N (ndb:open ndir (opts)))
(expect "reopen: WAL replay restores unflushed writes" (and (equal? (ndb:get N "zz-wal") "survives") (> (ndb:stat N "wal_records_replayed") 0)))
(expect "after reopen: full scan equals the reference" (same? "reopen scan" (db:scan R "" #f #f) (ndb:scan N "" #f #f)))
; live option changes keep the data
(ndb:set! N "now=1;memtable_rep=vector;cache_policy=lru;block_cache_blocks=4")
(ndb:put! N "zz-after" "x") (db:put! R "zz-after" "x")
(expect "live rep + cache change: memtable rep switched at once" (equal? (cdr (assoc "mem_rep" (ndb:stats N))) "vector"))
(ndb:set! N (if (equal? STYLE "leveled") "compaction_style=tiered" "compaction_style=leveled"))
(let loop ((i 0)) (if (< i 60) (let ((k (key (rnd! 300))) (v (val i))) (db:put! R k v) (ndb:put! N k v) (loop (+ i 1))) #t))
(expect "after style switch: full scan equals the reference" (same? "switch scan" (db:scan R "" #f #f) (ndb:scan N "" #f #f)))
(expect "after style switch: invariants" (= (ndb:check N) 0))
; refusals
(expect "empty key refused with an error" (equal? (try (begin (ndb:put! N "" "x") #f) (catch (e) #t)) #t))
(expect "unknown option refused" (equal? (try (begin (ndb:set! N "nosuch=1") #f) (catch (e) #t)) #t))
(ndb:close N)
(expect "closed handle refused" (equal? (try (begin (ndb:get N "k001") #f) (catch (e) #t)) #t))
(expect "no leaked native dbs / iterators" (= (ndb:live) 0))
(expect-summary)
